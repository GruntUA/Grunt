# Ґрунт — Змінні середовища
# Скопіюй у .env і заповни значення

# ──── Core ────────────────────────────────────
APP_NAME=Ґрунт
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# ──── Database ────────────────────────────────
# SQLite (dev, без додаткових залежностей):
DATABASE_URL=sqlite+aiosqlite:///./grunt.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://grunt:secret@localhost:5432/grunt

# MySQL/MariaDB (optional):
# DATABASE_URL=mysql+aiomysql://grunt:secret@localhost:3306/grunt

# ──── Redis (optional) ────────────────────────
# Без Redis: WebSocket і кеш вимкнені, Celery не працює
# REDIS_URL=redis://localhost:6379/0

# ──── Auth ────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ──── Storage ─────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ──── CORS ────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ──── Localization ────────────────────────────
DEFAULT_LOCALE=uk
DEFAULT_TIMEZONE=Europe/Kyiv
