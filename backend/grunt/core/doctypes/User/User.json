{
  "name": "User",
  "label": "Користувач",
  "module": "core",
  "is_child": false,
  "autoname": "field:email",
  "title_field": "full_name",
  "fields": [
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "full_name",
      "label": "Повне ім'я",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_active",
      "label": "Активний",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_superadmin",
      "label": "Суперадмін",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "hashed_password",
      "label": "Хешований пароль",
      "fieldtype": "LongText",
      "hidden": true
    },
    {
      "fieldname": "theme",
      "label": "Тема",
      "fieldtype": "Select",
      "options": "light\ndark\nsystem",
      "default": "system",
      "hidden": true
    },
    {
      "fieldname": "login_attempts",
      "label": "Failed login attempts",
      "fieldtype": "Int",
      "default": 0,
      "hidden": true
    },
    {
      "fieldname": "locked_until",
      "label": "Account locked until",
      "fieldtype": "Datetime",
      "hidden": true
    },
    {
      "fieldname": "mfa_enabled",
      "label": "MFA enabled",
      "fieldtype": "Check",
      "default": false,
      "hidden": true
    },
    {
      "fieldname": "mfa_secret",
      "label": "MFA secret",
      "fieldtype": "LongText",
      "hidden": true
    },
    {
      "fieldname": "mfa_backup_codes",
      "label": "MFA backup codes",
      "fieldtype": "JSON",
      "hidden": true
    }
  ]
}
