{
  "name": "WebForm",
  "label": "Веб-форма",
  "module": "core",
  "is_system": true,
  "fields": [
    {"fieldname": "title", "label": "Заголовок", "fieldtype": "Text", "required": true, "in_list_view": true},
    {"fieldname": "route", "label": "URL маршрут", "fieldtype": "Text", "required": true, "in_list_view": true},
    {"fieldname": "doctype", "label": "Тип документа", "fieldtype": "Link", "options": "DocType", "required": true, "in_list_view": true, "in_filter": true},
    {"fieldname": "introduction", "label": "Вступ", "fieldtype": "LongText"},
    {"fieldname": "success_message", "label": "Повідомлення успіху", "fieldtype": "Text", "default": "Дякуємо! Вашу заявку прийнято."},
    {"fieldname": "success_url", "label": "URL після відправки", "fieldtype": "Text"},
    {"fieldname": "login_required", "label": "Потрібна авторизація", "fieldtype": "Check", "default": false, "in_list_view": true},
    {"fieldname": "is_published", "label": "Опубліковано", "fieldtype": "Check", "default": true, "in_list_view": true, "in_filter": true},
    {"fieldname": "max_submissions", "label": "Макс. відповідей", "fieldtype": "Int", "default": 0},
    {"fieldname": "submit_label", "label": "Текст кнопки", "fieldtype": "Text", "default": "Надіслати"},
    {"fieldname": "fields", "label": "Поля (JSON)", "fieldtype": "JSON"}
  ]
}
