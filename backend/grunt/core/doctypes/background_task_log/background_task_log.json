{
  "name": "BackgroundTaskLog",
  "label": "Лог фонових завдань",
  "module": "core",
  "track_changes": false,
  "fields": [
    {"fieldname": "task_name", "label": "Завдання", "fieldtype": "Text", "in_list_view": true, "in_filter": true},
    {"fieldname": "status", "label": "Статус", "fieldtype": "Select", "options": "Started\nSuccess\nError\nRetrying", "in_list_view": true, "in_filter": true},
    {"fieldname": "started_at", "label": "Початок", "fieldtype": "Datetime", "in_list_view": true},
    {"fieldname": "finished_at", "label": "Завершення", "fieldtype": "Datetime", "in_list_view": true},
    {"fieldname": "retry_count", "label": "Спроб виконано", "fieldtype": "Int", "default": 0, "read_only": true, "in_list_view": true},
    {"fieldname": "next_attempt_at", "label": "Наступна спроба", "fieldtype": "Datetime", "read_only": true},
    {"fieldname": "error_message", "label": "Помилка", "fieldtype": "LongText"},
    {"fieldname": "arguments", "label": "Аргументи", "fieldtype": "JSON"}
  ]
}
