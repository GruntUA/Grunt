{
  "name": "DataImport",
  "label": "Імпорт даних",
  "module": "core",
  "is_system": true,
  "title_field": "doctype_name",
  "fields": [
    {"fieldname": "doctype_name", "label": "Тип документа", "fieldtype": "Link", "options": "DocType", "required": true, "in_list_view": true, "in_filter": true},
    {"fieldname": "file", "label": "Файл (CSV / XLSX)", "fieldtype": "Attach", "required": true},
    {"fieldname": "import_type", "label": "Тип імпорту", "fieldtype": "Select", "options": "Insert New\nUpdate Existing", "default": "Insert New", "required": true, "in_list_view": true},
    {"fieldname": "update_key", "label": "Ключ для оновлення", "fieldtype": "Data", "depends_on": "eval:doc.import_type === 'Update Existing'", "description": "Назва поля, за яким шукати існуючий документ"},
    {"fieldname": "mapping", "label": "Маппінг колонок", "fieldtype": "JSON", "description": "{\"Колонка у файлі\": \"fieldname_у_доктайпі\"}"},
    {"fieldname": "dry_run", "label": "Тільки валідація (без запису)", "fieldtype": "Check", "default": true},
    {"fieldname": "status", "label": "Статус", "fieldtype": "Select", "options": "Pending\nIn Progress\nSuccess\nPartial Success\nFailed", "default": "Pending", "read_only": true, "in_list_view": true, "in_filter": true},
    {"fieldname": "total_rows", "label": "Всього рядків", "fieldtype": "Int", "read_only": true, "in_list_view": true},
    {"fieldname": "processed_rows", "label": "Оброблено", "fieldtype": "Int", "read_only": true, "in_list_view": true},
    {"fieldname": "error_count", "label": "Помилок", "fieldtype": "Int", "read_only": true, "in_list_view": true},
    {"fieldname": "error_log", "label": "Лог помилок", "fieldtype": "JSON", "read_only": true}
  ],
  "permissions": [
    {"role": "System Manager", "read": true, "write": true, "create": true, "delete": true}
  ]
}
