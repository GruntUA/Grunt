{
  "name": "EmailAccount",
  "label": "Обліковий запис пошти",
  "module": "core",
  "fields": [
    {"fieldname": "email_address", "label": "Email адреса", "fieldtype": "Text", "required": true, "in_list_view": true},
    {"fieldname": "enable_outgoing", "label": "Дозволити вихідну пошту", "fieldtype": "Check", "default": false},
    {"fieldname": "smtp_server", "label": "SMTP сервер", "fieldtype": "Text", "depends_on": "eval:doc.enable_outgoing"},
    {"fieldname": "smtp_port", "label": "SMTP порт", "fieldtype": "Int", "default": 587, "depends_on": "eval:doc.enable_outgoing"},
    {"fieldname": "use_tls", "label": "Використовувати TLS", "fieldtype": "Check", "default": true, "depends_on": "eval:doc.enable_outgoing"},
    {"fieldname": "smtp_user", "label": "Користувач SMTP", "fieldtype": "Text", "depends_on": "eval:doc.enable_outgoing"},
    {"fieldname": "smtp_password", "label": "Пароль SMTP", "fieldtype": "Text", "depends_on": "eval:doc.enable_outgoing"},
    {"fieldname": "enable_incoming", "label": "Дозволити вхідну пошту", "fieldtype": "Check", "default": false},
    {"fieldname": "imap_server", "label": "IMAP сервер", "fieldtype": "Text", "depends_on": "eval:doc.enable_incoming"},
    {"fieldname": "imap_port", "label": "IMAP порт", "fieldtype": "Int", "default": 993, "depends_on": "eval:doc.enable_incoming"},
    {"fieldname": "use_ssl", "label": "Використовувати SSL", "fieldtype": "Check", "default": true, "depends_on": "eval:doc.enable_incoming"}
  ]
}
