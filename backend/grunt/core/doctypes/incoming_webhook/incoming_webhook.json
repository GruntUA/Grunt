{
  "name": "IncomingWebhook",
  "label": "Вхідний вебхук",
  "module": "core",
  "table_name": "grunt_incoming_webhook",
  "fields": [
    {"fieldname": "label", "label": "Назва", "fieldtype": "Data", "required": true, "in_list_view": true},
    {"fieldname": "slug", "label": "URL шлях (slug)", "fieldtype": "Data", "required": true, "in_list_view": true, "description": "Унікальний ідентифікатор у URL: POST /api/v1/webhooks/incoming/{slug}"},
    {"fieldname": "secret", "label": "Секрет (HMAC)", "fieldtype": "Text", "description": "Якщо задано — запити без валідного підпису відхиляються"},
    {"fieldname": "signature_header", "label": "Заголовок підпису", "fieldtype": "Data", "default": "X-Grunt-Signature", "description": "HTTP-заголовок, в якому очікується підпис (наприклад X-Hub-Signature-256)"},
    {"fieldname": "signature_type", "label": "Алгоритм підпису", "fieldtype": "Select", "options": "hmac_sha256\nhmac_sha1\nnone", "default": "hmac_sha256"},
    {"fieldname": "action", "label": "Дія", "fieldtype": "Select", "options": "log_only\nrun_server_script\ncreate_document", "default": "log_only", "required": true, "in_list_view": true},
    {"fieldname": "server_script", "label": "Серверний скрипт", "fieldtype": "Link", "options": "ServerScript", "description": "Виконується при action = run_server_script. Payload доступний як змінна payload."},
    {"fieldname": "target_doctype", "label": "Тип документа", "fieldtype": "Link", "options": "DocType", "description": "Тип документа для створення при action = create_document"},
    {"fieldname": "field_mapping", "label": "Маппінг полів (JSON)", "fieldtype": "LongText", "description": "JSON: {\"doctype_field\": \"payload.path.to.value\"}"},
    {"fieldname": "is_enabled", "label": "Активний", "fieldtype": "Check", "default": true, "in_list_view": true, "in_filter": true}
  ],
  "permissions": [
    {"role": "System Manager", "read": true, "write": true, "create": true, "delete": true}
  ]
}
