{
  "name": "User",
  "label": "Користувач",
  "module": "core",
  "is_child": false,
  "autoname": "field:email",
  "title_field": "full_name",
  "image_field": "avatar",
  "fields": [
    {
      "fieldname": "tab_general",
      "label": "Основне",
      "fieldtype": "Tab"
    },
    {
      "fieldname": "sec_general",
      "label": "Загальні дані",
      "fieldtype": "Section"
    },
    {
      "fieldname": "full_name",
      "label": "Повне ім'я",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "avatar",
      "label": "Фото профілю",
      "fieldtype": "Image",
      "in_list_view": true
    },
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Text",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "phone",
      "label": "Телефон",
      "fieldtype": "Text"
    },
    {
      "fieldname": "sec_bio",
      "label": "Про себе",
      "fieldtype": "Section"
    },
    {
      "fieldname": "bio",
      "label": "Коротка біографія",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "tab_security",
      "label": "Безпека",
      "fieldtype": "Tab"
    },
    {
      "fieldname": "sec_security",
      "label": "Доступ",
      "fieldtype": "Section"
    },
    {
      "fieldname": "is_active",
      "label": "Активний",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_superadmin",
      "label": "Суперадмін",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "col_security",
      "fieldtype": "Column"
    },
    {
      "fieldname": "password",
      "label": "Встановити пароль",
      "fieldtype": "Text",
      "hidden": false,
      "description": "Введіть новий пароль. У базі зберігатиметься лише його хеш."
    },
    {
      "fieldname": "hashed_password",
      "label": "Хешований пароль",
      "fieldtype": "LongText",
      "hidden": true
    },
    {
      "fieldname": "sec_mfa",
      "label": "MFA та Блокування",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "mfa_enabled",
      "label": "MFA увімкнено",
      "fieldtype": "Check",
      "default": false,
      "read_only": true
    },
    {
      "fieldname": "mfa_setup_button",
      "label": "Керування MFA",
      "fieldtype": "Button"
    },
    {
      "fieldname": "mfa_secret",
      "label": "Секрет MFA",
      "fieldtype": "LongText",
      "hidden": true
    },
    {
      "fieldname": "mfa_backup_codes",
      "label": "Хеші резервних кодів",
      "fieldtype": "JSON",
      "hidden": true
    },
    {
      "fieldname": "mfa_backup_display",
      "label": "Резервні коди",
      "fieldtype": "SmallText",
      "read_only": true,
      "description": "Ці коди відображаються лише один раз при активації. Ви бачите це поле, тому що MFA увімкнено."
    },
    {
      "fieldname": "col_mfa",
      "fieldtype": "Column"
    },
    {
      "fieldname": "login_attempts",
      "label": "Невдалі спроби входу",
      "fieldtype": "Int",
      "default": 0,
      "read_only": true
    },
    {
      "fieldname": "locked_until",
      "label": "Акаунт заблоковано до",
      "fieldtype": "Datetime",
      "read_only": true
    },
    {
      "fieldname": "tab_preferences",
      "label": "Налаштування",
      "fieldtype": "Tab"
    },
    {
      "fieldname": "sec_preferences",
      "label": "Інтерфейс",
      "fieldtype": "Section"
    },
    {
      "fieldname": "theme",
      "label": "Тема оформлення",
      "fieldtype": "Select",
      "options": "light\ndark\nsystem",
      "default": "system"
    },
    {
      "fieldname": "col_preferences",
      "fieldtype": "Column"
    },
    {
      "fieldname": "language",
      "label": "Мова",
      "fieldtype": "Select",
      "options": "uk\nen",
      "default": "uk"
    },
    {
      "fieldname": "sec_tokens",
      "label": "Токени сесій",
      "fieldtype": "Section",
      "hidden": true
    },
    {
      "fieldname": "refresh_token",
      "label": "Токен оновлення (Refresh)",
      "fieldtype": "Text",
      "hidden": true
    },
    {
      "fieldname": "refresh_token_expires_at",
      "label": "Час дії Refresh токену",
      "fieldtype": "Datetime",
      "hidden": true
    },
    {
      "fieldname": "col_tokens",
      "fieldtype": "Column",
      "hidden": true
    },
    {
      "fieldname": "reset_token",
      "label": "Токен відновлення пароля",
      "fieldtype": "Text",
      "hidden": true
    },
    {
      "fieldname": "reset_token_expires_at",
      "label": "Час дії токену відновлення",
      "fieldtype": "Datetime",
      "hidden": true
    }
  ]
}