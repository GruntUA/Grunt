{
  "name": "AdminService",
  "label": "Адміністративна послуга",
  "module": "registry",
  "title_field": "service_name",
  "search_fields": ["service_name", "service_code"],
  "fields": [
    {"fieldname": "service_code", "label": "Код послуги",
     "fieldtype": "Text", "unique": true, "required": true, "in_list_view": true, "in_filter": true},

    {"fieldname": "service_name", "label": "Назва послуги",
     "fieldtype": "Text", "required": true, "in_list_view": true},

    {"fieldname": "category", "label": "Категорія",
     "fieldtype": "Link", "options": "ServiceCategory",
     "required": true, "in_list_view": true, "in_filter": true},

    {"fieldname": "section_terms", "label": "Умови надання",
     "fieldtype": "Section"},

    {"fieldname": "deadline_days", "label": "Строк надання (днів)",
     "fieldtype": "Int", "default": 5, "required": true},

    {"fieldname": "fee_uah", "label": "Вартість (грн)",
     "fieldtype": "Float", "default": 0},

    {"fieldname": "col_1", "fieldtype": "Column", "label": ""},

    {"fieldname": "law_basis", "label": "Правова підстава",
     "fieldtype": "Text"},

    {"fieldname": "result_document", "label": "Результат послуги",
     "fieldtype": "Text"},

    {"fieldname": "section_docs", "label": "Необхідні документи",
     "fieldtype": "Section"},

    {"fieldname": "required_documents", "label": "Перелік документів",
     "fieldtype": "RichText"},

    {"fieldname": "is_active", "label": "Активна",
     "fieldtype": "Check", "default": true}
  ],
  "permissions": [
    {"role": "ЦНАП Оператор", "read": true},
    {"role": "ЦНАП Керівник", "read": true, "write": true, "create": true, "delete": true}
  ]
}
