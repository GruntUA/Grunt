{
  "name": "ServiceCategory",
  "label": "Категорія послуги",
  "module": "registry",
  "title_field": "category_name",
  "fields": [
    {"fieldname": "category_name", "label": "Назва категорії",
     "fieldtype": "Text", "required": true, "unique": true, "in_list_view": true},
    {"fieldname": "code", "label": "Код",
     "fieldtype": "Text", "max_length": 10, "in_list_view": true},
    {"fieldname": "description", "label": "Опис",
     "fieldtype": "LongText"},
    {"fieldname": "is_active", "label": "Активна",
     "fieldtype": "Check", "default": true, "in_list_view": true}
  ],
  "permissions": [
    {"role": "ЦНАП Оператор", "read": true},
    {"role": "ЦНАП Керівник", "read": true, "write": true, "create": true, "delete": true}
  ]
}
