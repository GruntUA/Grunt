{
  "name": "ApiKey",
  "label": "API Key",
  "module": "auth",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "user_id",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "key_prefix",
      "label": "Key prefix",
      "fieldtype": "Data",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "key_hash",
      "label": "Key hash",
      "fieldtype": "Data",
      "hidden": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "last_used_at",
      "label": "Last used",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "expires_at",
      "label": "Valid until",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "allowed_ips",
      "label": "Allowed IPs (comma-separated)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "sec_scope",
      "label": "What the key may do",
      "fieldtype": "Section"
    },
    {
      "fieldname": "read_only",
      "label": "Read only",
      "fieldtype": "Check",
      "default": false,
      "description": "Requests with this key may only read: any other method gets 403, and no document is created, changed or deleted."
    },
    {
      "fieldname": "roles",
      "label": "Roles",
      "fieldtype": "Table",
      "options": "ApiKeyRole",
      "description": "Only these of the user's roles (with the user's scopes); empty - all of them. The key never gets more than its user has."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "actions": ["read", "write", "create", "delete", "export", "import", "print", "share", "report"]
    }
  ]
}
