{
  "name": "ApiKey",
  "label": "API Key",
  "module": "auth",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "user_id",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "key_prefix",
      "label": "Key prefix",
      "fieldtype": "Data",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "key_hash",
      "label": "Key hash",
      "fieldtype": "Text",
      "hidden": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "last_used_at",
      "label": "Last used",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "expires_at",
      "label": "Valid until",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "allowed_ips",
      "label": "Allowed IPs (comma-separated)",
      "fieldtype": "Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
