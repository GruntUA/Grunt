{
  "name": "EmailLoginToken",
  "label": "Email login token",
  "module": "auth",
  "autoname": "hash",
  "title_field": "email",
  "track_changes": false,
  "description": "A one-time token for passwordless sign-in (code + magic link). A successful sign-in by either path marks the row used, and the other path stops working.",
  "fields": [
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data",
      "required": true,
      "read_only": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "code_hash",
      "label": "Code hash",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "expires_at",
      "label": "Valid until",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "consumed_at",
      "label": "Used",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "ip_address",
      "label": "Request IP address",
      "fieldtype": "Data",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
