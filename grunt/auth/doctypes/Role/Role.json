{
  "name": "Role",
  "label": "Role",
  "module": "auth",
  "hide_from_activity_feed": true,
  "autoname": "field:role_name",
  "title_field": "role_name",
  "fields": [
    {
      "fieldname": "role_name",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "require_mfa",
      "label": "Require two-factor authentication",
      "fieldtype": "Check",
      "in_list_view": true,
      "description": "Users with this role must set up 2FA (TOTP) before they can sign in."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
