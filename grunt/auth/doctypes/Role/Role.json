{
  "name": "Role",
  "label": "Role",
  "module": "auth",
  "hide_from_activity_feed": true,
  "autoname": "field:role_name",
  "title_field": "role_name",
  "fields": [
    {
      "fieldname": "role_name",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "require_mfa",
      "label": "Require two-factor authentication",
      "fieldtype": "Check",
      "in_list_view": true,
      "description": "Users with this role must set up 2FA (TOTP) before they can sign in."
    },
    {
      "fieldname": "allowed_ips",
      "label": "Allowed sign-in IPs",
      "fieldtype": "LongText",
      "description": "Users with this role can sign in only from these addresses or networks (e.g. 10.0.0.0/8), one per line. Empty — no restriction."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
