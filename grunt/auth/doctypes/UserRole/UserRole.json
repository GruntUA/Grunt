{
  "name": "UserRole",
  "label": "User role",
  "module": "auth",
  "hide_from_activity_feed": true,
  "is_child": true,
  "fields": [
    {
      "fieldname": "role_name",
      "label": "Role",
      "fieldtype": "Link",
      "options": "Role",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "scope_doctype",
      "label": "Scope",
      "fieldtype": "Link",
      "options": "DocType",
      "in_list_view": true,
      "description": "Limit the role to documents linked to this record (a department, a section). Empty - the role applies everywhere."
    },
    {
      "fieldname": "scope_value",
      "label": "Scope value",
      "fieldtype": "DynamicLink",
      "options": "scope_doctype",
      "in_list_view": true,
      "depends_on": "eval:doc.scope_doctype",
      "mandatory_depends_on": "eval:doc.scope_doctype"
    },
    {
      "fieldname": "valid_from",
      "label": "Valid from",
      "fieldtype": "Date"
    },
    {
      "fieldname": "valid_to",
      "label": "Valid to",
      "fieldtype": "Date"
    },
    {
      "fieldname": "role_profile",
      "label": "From profile",
      "fieldtype": "Link",
      "options": "RoleProfile",
      "read_only": true,
      "in_list_view": true,
      "description": "Added by this role profile: it changes with the profile and is rebuilt on every save."
    }
  ]
}
