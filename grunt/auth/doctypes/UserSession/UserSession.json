{
  "name": "UserSession",
  "label": "User session",
  "module": "auth",
  "is_log": true,
  "retention_date_field": "last_active_at",
  "track_activity": false,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "refresh_token_hash",
      "label": "Refresh token hash",
      "fieldtype": "Data",
      "hidden": true
    },
    {
      "fieldname": "device_id",
      "label": "Device ID",
      "fieldtype": "Data",
      "hidden": true
    },
    {
      "fieldname": "ip_address",
      "label": "IP address",
      "fieldtype": "Data",
      "in_list_view": true
    },
    {
      "fieldname": "user_agent",
      "label": "Browser / client",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "last_active_at",
      "label": "Last activity",
      "fieldtype": "Datetime",
      "in_list_view": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "logins",
      "label": "Sign-ins",
      "fieldtype": "Table",
      "options": "UserSessionLogin"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "delete": true,
      "match": "user == user",
      "hidden_fields": [
        "refresh_token_hash"
      ]
    }
  ]
}
