{
  "name": "UserSession",
  "label": "User session",
  "module": "auth",
  "is_log": true,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "session_key",
      "label": "Session key",
      "fieldtype": "Text",
      "required": true,
      "hidden": true
    },
    {
      "fieldname": "ip_address",
      "label": "IP address",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "user_agent",
      "label": "Browser / client",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "last_active_at",
      "label": "Last activity",
      "fieldtype": "Datetime",
      "in_list_view": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "write": true,
      "match": "user == user"
    }
  ]
}
