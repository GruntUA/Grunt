{
  "name": "WebAuthnCredential",
  "label": "Passkey",
  "module": "auth",
  "autoname": "hash",
  "title_field": "label",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "Friendly name of the device / authenticator"
    },
    {
      "fieldname": "last_used_at",
      "label": "Last used",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "backed_up",
      "label": "Synced",
      "fieldtype": "Check",
      "read_only": true,
      "description": "The key syncs via the cloud (e.g. iCloud Keychain, Google Password Manager)"
    },
    {
      "fieldname": "sec_technical",
      "label": "Technical details",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "credential_id",
      "label": "Credential ID",
      "fieldtype": "Text",
      "required": true,
      "unique": true,
      "read_only": true
    },
    {
      "fieldname": "public_key",
      "label": "Public key",
      "fieldtype": "LongText",
      "required": true,
      "read_only": true
    },
    {
      "fieldname": "sign_count",
      "label": "Signature counter",
      "fieldtype": "Int",
      "default": 0,
      "read_only": true
    },
    {
      "fieldname": "col_technical",
      "fieldtype": "Column"
    },
    {
      "fieldname": "aaguid",
      "label": "AAGUID",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "transports",
      "label": "Transports",
      "fieldtype": "Data",
      "read_only": true,
      "description": "Comma-separated list: usb, nfc, ble, internal, hybrid"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    },
    {
      "role": "All",
      "read": true,
      "delete": true,
      "match": "user == user"
    }
  ]
}
