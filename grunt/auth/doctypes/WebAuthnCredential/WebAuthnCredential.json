{
  "name": "WebAuthnCredential",
  "label": "Ключ доступу (Passkey)",
  "module": "auth",
  "autoname": "hash",
  "title_field": "label",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "user",
      "label": "Користувач",
      "fieldtype": "Link",
      "options": "User",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "label",
      "label": "Назва",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "Дружня назва пристрою / автентифікатора"
    },
    {
      "fieldname": "last_used_at",
      "label": "Востаннє використано",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "backed_up",
      "label": "Синхронізований",
      "fieldtype": "Check",
      "read_only": true,
      "description": "Ключ синхронізується через хмару (напр. iCloud Keychain, Google Password Manager)"
    },
    {
      "fieldname": "sec_technical",
      "label": "Технічні дані",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "credential_id",
      "label": "Credential ID",
      "fieldtype": "Text",
      "required": true,
      "unique": true,
      "read_only": true
    },
    {
      "fieldname": "public_key",
      "label": "Публічний ключ",
      "fieldtype": "LongText",
      "required": true,
      "read_only": true
    },
    {
      "fieldname": "sign_count",
      "label": "Лічильник підписів",
      "fieldtype": "Int",
      "default": 0,
      "read_only": true
    },
    {
      "fieldname": "col_technical",
      "fieldtype": "Column"
    },
    {
      "fieldname": "aaguid",
      "label": "AAGUID",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "transports",
      "label": "Транспорти",
      "fieldtype": "Data",
      "read_only": true,
      "description": "Список через кому: usb, nfc, ble, internal, hybrid"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    },
    {
      "role": "All",
      "read": true,
      "delete": true,
      "match": "user == user"
    }
  ]
}
