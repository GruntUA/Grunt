{
  "name": "Comment",
  "label": "Коментар",
  "module": "document",
  "indexes": [["reference_doctype", "reference_id"]],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Тип документа",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true
    },
    {
      "fieldname": "reference_id",
      "label": "ID документа",
      "fieldtype": "Text",
      "required": true
    },
    {
      "fieldname": "content",
      "label": "Вміст",
      "fieldtype": "LongText",
      "required": true
    },
    {
      "fieldname": "comment_type",
      "label": "Тип",
      "fieldtype": "Select",
      "options": "Comment\nInfo\nWarning\nError",
      "default": "Comment"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "create": true
    },
    {
      "role": "All",
      "write": true,
      "delete": true,
      "match": "owner == user"
    }
  ]
}
