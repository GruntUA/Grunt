{
  "name": "Comment",
  "label": "Comment",
  "module": "document",
  "indexes": [
    [
      "reference_doctype",
      "reference_id"
    ],
    [
      "parent_comment"
    ]
  ],
  "inherit_permission_from": [
    [
      "reference_doctype",
      "reference_id"
    ]
  ],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true
    },
    {
      "fieldname": "reference_id",
      "label": "Document ID",
      "fieldtype": "Text",
      "required": true
    },
    {
      "fieldname": "content",
      "label": "Content",
      "fieldtype": "LongText",
      "required": true
    },
    {
      "fieldname": "comment_type",
      "label": "Type",
      "fieldtype": "Select",
      "options": "Comment\nInfo\nWarning\nError",
      "translatable": true,
      "default": "Comment"
    },
    {
      "fieldname": "parent_comment",
      "label": "Reply to",
      "fieldtype": "Link",
      "options": "Comment",
      "read_only": true,
      "description": "The comment this one replies to (threads are one level deep)"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "create": true
    },
    {
      "role": "All",
      "write": true,
      "delete": true,
      "match": "owner == user"
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
