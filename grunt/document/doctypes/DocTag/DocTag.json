{
  "name": "DocTag",
  "label": "Тег документа",
  "module": "document",
  "track_changes": false,
  "hide_from_activity_feed": true,
  "indexes": [["reference_doctype", "reference_id"]],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Тип документа",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "reference_id",
      "label": "ID документа",
      "fieldtype": "Text",
      "required": true,
      "in_filter": true
    },
    {
      "fieldname": "tag",
      "label": "Тег",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "create": true
    },
    {
      "role": "All",
      "write": true,
      "delete": true,
      "match": "owner == user"
    }
  ]
}
