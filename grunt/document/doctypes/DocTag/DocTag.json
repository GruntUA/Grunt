{
  "name": "DocTag",
  "label": "Document Tag",
  "module": "document",
  "track_changes": false,
  "hide_from_activity_feed": true,
  "indexes": [
    [
      "reference_doctype",
      "reference_id"
    ]
  ],
  "inherit_permission_from": [
    "reference_doctype",
    "reference_id"
  ],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "reference_id",
      "label": "Document ID",
      "fieldtype": "Text",
      "required": true,
      "in_filter": true
    },
    {
      "fieldname": "tag",
      "label": "Tag",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "create": true
    },
    {
      "role": "All",
      "write": true,
      "delete": true,
      "match": "owner == user"
    }
  ]
}
