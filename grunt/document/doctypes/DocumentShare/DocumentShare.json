{
  "name": "DocumentShare",
  "label": "Shared With",
  "module": "document",
  "table_name": "grunt_document_share",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "doctype_name",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "doc_id",
      "label": "Document ID",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "token",
      "label": "Token",
      "fieldtype": "Data",
      "hidden": true,
      "read_only": true
    },
    {
      "fieldname": "expires_at",
      "label": "Valid until",
      "fieldtype": "Datetime",
      "in_list_view": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "view_count",
      "label": "Views",
      "fieldtype": "Int",
      "default": 0,
      "read_only": true
    },
    {
      "fieldname": "note",
      "label": "Note",
      "fieldtype": "Text"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "match": "owner == user"
    }
  ]
}
