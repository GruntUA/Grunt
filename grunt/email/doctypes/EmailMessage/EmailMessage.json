{
  "name": "EmailMessage",
  "label": "Email Message",
  "module": "email",
  "title_field": "subject",
  "default_view": "list",
  "track_changes": false,
  "search_fields": [
    "subject",
    "sender",
    "recipients"
  ],
  "status_field": "status",
  "status_indicators": [
    {
      "value": "Received",
      "color": "blue",
      "icon": "inbox"
    },
    {
      "value": "Sent",
      "color": "blue",
      "icon": "send"
    },
    {
      "value": "Delivered",
      "color": "green",
      "icon": "circle-check"
    },
    {
      "value": "Undelivered",
      "color": "red",
      "icon": "circle-x"
    },
    {
      "value": "Deferred",
      "color": "orange",
      "icon": "clock"
    },
    {
      "value": "Queued",
      "color": "yellow",
      "icon": "loader"
    },
    {
      "value": "Error",
      "color": "red",
      "icon": "circle-x"
    }
  ],
  "fields": [
    {
      "fieldname": "tab_main",
      "label": "Email",
      "fieldtype": "Tab",
      "icon": "mail"
    },
    {
      "fieldname": "sec_head",
      "label": "",
      "fieldtype": "Section"
    },
    {
      "fieldname": "col_h1",
      "fieldtype": "Column"
    },
    {
      "fieldname": "direction",
      "label": "Direction",
      "fieldtype": "Select",
      "options": "Incoming\nOutgoing",
      "translatable": true,
      "required": true,
      "read_only": true,
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "message_date",
      "label": "Date / time",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true,
      "index": true
    },
    {
      "fieldname": "col_h2",
      "fieldtype": "Column"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Received\nSent\nDelivered\nUndelivered\nDeferred\nQueued\nError",
      "translatable": true,
      "read_only": true,
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "email_account",
      "label": "Account",
      "fieldtype": "Link",
      "options": "EmailAccount",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "sec_env",
      "label": "",
      "fieldtype": "Section"
    },
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Text",
      "read_only": true,
      "in_list_view": true,
      "bold": true
    },
    {
      "fieldname": "sender",
      "label": "From",
      "fieldtype": "Text",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "recipients",
      "label": "To",
      "fieldtype": "Text",
      "read_only": true
    },
    {
      "fieldname": "cc",
      "label": "Cc",
      "fieldtype": "Text",
      "read_only": true,
      "depends_on": "eval: doc.cc"
    },
    {
      "fieldname": "sec_body",
      "label": "Email body",
      "fieldtype": "Section"
    },
    {
      "fieldname": "body_html",
      "label": "HTML",
      "fieldtype": "RichText",
      "read_only": true,
      "depends_on": "eval: doc.body_html"
    },
    {
      "fieldname": "body_text",
      "label": "Text",
      "fieldtype": "LongText",
      "read_only": true,
      "depends_on": "eval: !doc.body_html"
    },
    {
      "fieldname": "sec_att",
      "label": "Attachments",
      "fieldtype": "Section",
      "depends_on": "eval: doc.has_attachments"
    },
    {
      "fieldname": "has_attachments",
      "label": "Has attachments",
      "fieldtype": "Check",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "attachments",
      "label": "Attachments",
      "fieldtype": "Table",
      "options": "EmailAttachment",
      "read_only": true
    },
    {
      "fieldname": "sec_err",
      "label": "Delivery error",
      "fieldtype": "Section",
      "depends_on": "eval: doc.error_message"
    },
    {
      "fieldname": "error_message",
      "label": "Error text",
      "fieldtype": "LongText",
      "read_only": true
    },
    {
      "fieldname": "sec_tracking",
      "label": "Delivery tracking",
      "fieldtype": "Section",
      "depends_on": "eval: doc.direction === 'Вихідний'"
    },
    {
      "fieldname": "col_t1",
      "fieldtype": "Column"
    },
    {
      "fieldname": "delivered_at",
      "label": "Delivered at",
      "fieldtype": "Datetime",
      "read_only": true
    },
    {
      "fieldname": "read_at",
      "label": "Read by recipient at",
      "fieldtype": "Datetime",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "col_t2",
      "fieldtype": "Column"
    },
    {
      "fieldname": "request_receipt",
      "label": "Read receipt requested",
      "fieldtype": "Check",
      "read_only": true
    },
    {
      "fieldname": "delivery_detail",
      "label": "Delivery details / diagnostics",
      "fieldtype": "LongText",
      "read_only": true,
      "depends_on": "eval: doc.delivery_detail"
    },
    {
      "fieldname": "sec_meta",
      "label": "Internal",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "col_m1",
      "fieldtype": "Column"
    },
    {
      "fieldname": "ref_doctype",
      "label": "Source — type",
      "fieldtype": "Text",
      "read_only": true,
      "in_filter": true
    },
    {
      "fieldname": "ref_name",
      "label": "Source — record",
      "fieldtype": "Text",
      "read_only": true,
      "in_filter": true
    },
    {
      "fieldname": "col_m2",
      "fieldtype": "Column"
    },
    {
      "fieldname": "message_id",
      "label": "Message-ID",
      "fieldtype": "Text",
      "read_only": true,
      "unique": true,
      "index": true
    },
    {
      "fieldname": "is_read",
      "label": "Read",
      "fieldtype": "Check"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
