{
  "name": "EmailQueue",
  "label": "Email Queue",
  "module": "email",
  "track_activity": false,
  "track_deletions": false,
  "fields": [
    {
      "fieldname": "sender",
      "label": "Sender",
      "fieldtype": "Data",
      "in_list_view": true
    },
    {
      "fieldname": "recipient",
      "label": "Recipient",
      "fieldtype": "Data",
      "in_list_view": true
    },
    {
      "fieldname": "cc",
      "label": "Cc",
      "fieldtype": "Data"
    },
    {
      "fieldname": "bcc",
      "label": "Bcc",
      "fieldtype": "Data"
    },
    {
      "fieldname": "reply_to",
      "label": "Reply-To",
      "fieldtype": "Data"
    },
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Data",
      "in_list_view": true
    },
    {
      "fieldname": "content",
      "label": "Content",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "text_content",
      "label": "Text version",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "is_html",
      "label": "HTML",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending\nSending\nSent\nError",
      "translatable": true,
      "default": "Pending",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "error_message",
      "label": "Error",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "email_account",
      "label": "Account",
      "fieldtype": "Link",
      "options": "EmailAccount"
    },
    {
      "fieldname": "attachments",
      "label": "Attachments",
      "fieldtype": "JSON",
      "read_only": true,
      "hidden": true,
      "description": "Files sent with the message: [{filename, mimetype, content_b64}]."
    },
    {
      "fieldname": "message_id",
      "label": "Message-ID",
      "fieldtype": "Data",
      "read_only": true,
      "description": "Set in advance when the letter is already on a document's timeline as “Queued”"
    },
    {
      "fieldname": "in_reply_to",
      "label": "In-Reply-To",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "message_references",
      "label": "References",
      "fieldtype": "LongText",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "ref_doctype",
      "label": "Source — type",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "ref_name",
      "label": "Source — record",
      "fieldtype": "Data",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "actions": ["read", "write", "create", "delete", "export", "import", "print", "share", "report"]
    }
  ]
}
