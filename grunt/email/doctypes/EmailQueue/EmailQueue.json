{
  "name": "EmailQueue",
  "label": "Черга листів",
  "module": "email",
  "track_activity": false,
  "track_deletions": false,
  "fields": [
    {
      "fieldname": "sender",
      "label": "Відправник",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "recipient",
      "label": "Отримувач",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "subject",
      "label": "Тема",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "content",
      "label": "Вміст",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "text_content",
      "label": "Текстова версія",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "is_html",
      "label": "HTML",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "status",
      "label": "Статус",
      "fieldtype": "Select",
      "options": "Pending\nSending\nSent\nError",
      "translatable": true,
      "default": "Pending",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "error_message",
      "label": "Помилка",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "email_account",
      "label": "Обліковий запис",
      "fieldtype": "Link",
      "options": "EmailAccount"
    },
    {
      "fieldname": "attachments",
      "label": "Attachments",
      "fieldtype": "JSON",
      "read_only": true,
      "hidden": true,
      "description": "Files sent with the message: [{filename, mimetype, content_b64}]."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
