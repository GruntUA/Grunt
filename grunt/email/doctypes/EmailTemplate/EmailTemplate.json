{
  "name": "EmailTemplate",
  "label": "Шаблон листа",
  "module": "email",
  "title_field": "label",
  "track_changes": true,
  "search_fields": ["label"],
  "fields": [
    {
      "fieldname": "label",
      "label": "Назва",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "Для орієнтації в списку — на саму розсилку не впливає"
    },
    {
      "fieldname": "is_active",
      "label": "Активний",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "sec_content",
      "label": "Вміст",
      "fieldtype": "Section"
    },
    {
      "fieldname": "subject",
      "label": "Тема листа",
      "fieldtype": "Text",
      "required": true,
      "description": "Підстановка значень — {ім'я_поля} з контексту, який передає викликач"
    },
    {
      "fieldname": "body",
      "label": "Текст (звичайний)",
      "fieldtype": "LongText",
      "required": true,
      "description": "Текстова версія — завжди надсилається; підстановка та сама, {ім'я_поля}"
    },
    {
      "fieldname": "body_html",
      "label": "Текст (HTML)",
      "fieldtype": "HTMLEditor",
      "description": "Необов'язково. Якщо заповнено — лист іде як HTML з текстовою версією як запасний варіант"
    },
    {
      "fieldname": "sec_help",
      "label": "Довідка",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "description",
      "label": "Де використовується / доступні поля",
      "fieldtype": "LongText"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
