{
  "name": "EmailTemplate",
  "label": "Email Template",
  "module": "email",
  "title_field": "label",
  "track_changes": true,
  "search_fields": [
    "label"
  ],
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "For orientation in the list — does not affect sending"
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "sec_content",
      "label": "Content",
      "fieldtype": "Section"
    },
    {
      "fieldname": "subject",
      "label": "Email subject",
      "fieldtype": "Text",
      "required": true,
      "description": "Value substitution — {field_name} from the context passed by the caller"
    },
    {
      "fieldname": "body",
      "label": "Text (plain)",
      "fieldtype": "LongText",
      "required": true,
      "description": "Text version — always sent; same substitution, {field_name}"
    },
    {
      "fieldname": "body_html",
      "label": "Text (HTML)",
      "fieldtype": "HTMLEditor",
      "description": "Optional. If set, the email is sent as HTML with the text version as a fallback"
    },
    {
      "fieldname": "sec_help",
      "label": "Help",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "description",
      "label": "Where used / available fields",
      "fieldtype": "LongText"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
