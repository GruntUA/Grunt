{
  "name": "Address",
  "label": "Address",
  "module": "geo",
  "autoname": "hash",
  "title_field": "full_address",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "address_type",
      "label": "Address type",
      "fieldtype": "Select",
      "options": "\nRegistered\nActual\nPostal\nLegal",
      "translatable": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "country",
      "label": "Country",
      "fieldtype": "Link",
      "options": "Country",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "region",
      "label": "Region / Oblast",
      "fieldtype": "Link",
      "options": "Region",
      "in_filter": true
    },
    {
      "fieldname": "city",
      "label": "City (directory)",
      "fieldtype": "Link",
      "options": "City"
    },
    {
      "fieldname": "city_text",
      "label": "City (text)",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "Enter the city name manually if it is not in the directory"
    },
    {
      "fieldname": "zip_code",
      "label": "Postal code",
      "fieldtype": "Data"
    },
    {
      "fieldname": "street",
      "label": "Street",
      "fieldtype": "Data"
    },
    {
      "fieldname": "building",
      "label": "Building",
      "fieldtype": "Data"
    },
    {
      "fieldname": "apartment",
      "label": "Apartment / Office",
      "fieldtype": "Data"
    },
    {
      "fieldname": "full_address",
      "label": "Full address",
      "fieldtype": "LongText",
      "read_only": true,
      "in_list_view": true,
      "description": "Built automatically from the address fields"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "LongText"
    }
  ],
  "default_view": "list",
  "search_fields": [
    "city_text",
    "street",
    "zip_code",
    "full_address"
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
