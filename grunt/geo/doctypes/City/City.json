{
  "name": "City",
  "label": "Місто",
  "module": "geo",
  "autoname": "field:title",
  "title_field": "title",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "title",
      "label": "Назва",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "bold": true
    },
    {
      "fieldname": "title_uk",
      "label": "Назва (укр.)",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "country",
      "label": "Країна",
      "fieldtype": "Link",
      "options": "Country",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "region",
      "label": "Регіон",
      "fieldtype": "Link",
      "options": "Region",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_capital",
      "label": "Столиця",
      "fieldtype": "Check",
      "default": "0",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "population",
      "label": "Населення",
      "fieldtype": "Int"
    },
    {
      "fieldname": "latitude",
      "label": "Широта",
      "fieldtype": "Float",
      "description": "Географічна широта (десяткові градуси)"
    },
    {
      "fieldname": "longitude",
      "label": "Довгота",
      "fieldtype": "Float",
      "description": "Географічна довгота (десяткові градуси)"
    },
    {
      "fieldname": "is_active",
      "label": "Активне",
      "fieldtype": "Check",
      "default": "1",
      "in_filter": true
    }
  ],
  "default_view": "list",

  "quick_filters": [{"id": "country_filter", "field": "country", "label": "Країна", "input_type": "select", "on_change": {"debounce_ms": 0}}, {"id": "capital_filter", "field": "is_capital", "label": "Лише столиці", "input_type": "select", "on_change": {"debounce_ms": 0}}],
  "search_fields": ["title", "title_uk"],
  "permissions": [
    { "role": "All", "read": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "delete": true }
  ]
}
