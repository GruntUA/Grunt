{
  "name": "City",
  "label": "City",
  "module": "geo",
  "autoname": "field:title",
  "title_field": "title",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "title",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "bold": true
    },
    {
      "fieldname": "title_uk",
      "label": "Name (Ukrainian)",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "country",
      "label": "Country",
      "fieldtype": "Link",
      "options": "Country",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "region",
      "label": "Region",
      "fieldtype": "Link",
      "options": "Region",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_capital",
      "label": "Capital",
      "fieldtype": "Check",
      "default": "0",
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "population",
      "label": "Population",
      "fieldtype": "Int"
    },
    {
      "fieldname": "latitude",
      "label": "Latitude",
      "fieldtype": "Float",
      "description": "Latitude (decimal degrees)"
    },
    {
      "fieldname": "longitude",
      "label": "Longitude",
      "fieldtype": "Float",
      "description": "Longitude (decimal degrees)"
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_filter": true
    }
  ],
  "default_view": "list",
  "search_fields": [
    "title",
    "title_uk"
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
