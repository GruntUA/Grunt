{
  "name": "Country",
  "label": "Country",
  "module": "geo",
  "autoname": "field:code",
  "title_field": "title",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "code",
      "label": "ISO 3166-1 alpha-2 code",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "Two-letter country code (UA, US, DE)"
    },
    {
      "fieldname": "code3",
      "label": "ISO 3166-1 alpha-3 code",
      "fieldtype": "Data",
      "description": "Three-letter country code (UKR, USA, DEU)"
    },
    {
      "fieldname": "numeric_code",
      "label": "Numeric code",
      "fieldtype": "Data",
      "description": "ISO 3166-1 numeric code (804 for Ukraine)"
    },
    {
      "fieldname": "flag_emoji",
      "label": "Flag",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "Country flag emoji (🇺🇦)"
    },
    {
      "fieldname": "title",
      "label": "Name (English)",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "title_uk",
      "label": "Name (Ukrainian)",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "continent",
      "label": "Continent",
      "fieldtype": "Select",
      "options": "\nAfrica\nAsia\nAustralia and Oceania\nAntarctica\nEurope\nNorth America\nSouth America",
      "translatable": true,
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "capital",
      "label": "Capital",
      "fieldtype": "Data"
    },
    {
      "fieldname": "phone_code",
      "label": "Dialing code",
      "fieldtype": "Data",
      "description": "International dialing code (+380)"
    },
    {
      "fieldname": "tld",
      "label": "Top-level domain",
      "fieldtype": "Data",
      "description": "National domain (.ua, .us)"
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "in_filter": true
    },
    {
      "fieldname": "official_language",
      "label": "Official language",
      "fieldtype": "Link",
      "options": "Language",
      "in_filter": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    }
  ],
  "default_view": "list",
  "search_fields": [
    "code",
    "title",
    "title_uk"
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
