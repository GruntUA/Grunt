{
  "name": "Currency",
  "label": "Currency",
  "module": "geo",
  "autoname": "field:code",
  "title_field": "title",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "code",
      "label": "ISO 4217 code",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "Three-letter currency code (UAH, USD, EUR)"
    },
    {
      "fieldname": "title",
      "label": "Name (English)",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "title_uk",
      "label": "Name (Ukrainian)",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "symbol",
      "label": "Symbol",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "Currency symbol: ₴, $, €"
    },
    {
      "fieldname": "numeric_code",
      "label": "Numeric code",
      "fieldtype": "Data",
      "description": "Three-digit ISO 4217 numeric code (980, 840, 978)"
    },
    {
      "fieldname": "decimal_places",
      "label": "Decimal places",
      "fieldtype": "Int",
      "default": "2",
      "description": "Number of decimal places (0 for JPY, 2 for USD)"
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": true,
      "in_filter": true
    }
  ],
  "default_view": "list",
  "search_fields": [
    "code",
    "title",
    "title_uk",
    "symbol"
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
