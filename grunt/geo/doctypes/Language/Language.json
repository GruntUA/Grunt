{
  "name": "Language",
  "label": "Language",
  "module": "geo",
  "autoname": "field:code",
  "title_field": "title",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "code",
      "label": "ISO 639-1 code",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "Two-letter language code (uk, en, de, fr)"
    },
    {
      "fieldname": "title",
      "label": "Name (English)",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "native_name",
      "label": "Native name",
      "fieldtype": "Text",
      "in_list_view": true,
      "description": "Language name in the language itself (Українська, English, Deutsch)"
    },
    {
      "fieldname": "script",
      "label": "Script",
      "fieldtype": "Select",
      "options": "Latin\nCyrillic\nArabic\nChinese\nDevanagari\nGreek\nHebrew\nJapanese\nKorean\nOther",
      "translatable": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": true,
      "in_filter": true
    }
  ],
  "default_view": "list",
  "search_fields": [
    "code",
    "title",
    "native_name"
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
