{
  "name": "Region",
  "label": "Region",
  "module": "geo",
  "autoname": "field:title",
  "title_field": "title",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "title",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "bold": true
    },
    {
      "fieldname": "title_uk",
      "label": "Name (Ukrainian)",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "country",
      "label": "Country",
      "fieldtype": "Link",
      "options": "Country",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "code",
      "label": "ISO 3166-2 code",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "Subdivision code (UA-30 for Kyiv, US-CA for California)"
    },
    {
      "fieldname": "region_type",
      "label": "Type",
      "fieldtype": "Select",
      "options": "\nOblast\nState\nProvince\nLand\nRegion\nCanton\nDepartment\nOther",
      "translatable": true,
      "in_filter": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_filter": true
    }
  ],
  "default_view": "list",
  "search_fields": [
    "title",
    "title_uk",
    "code"
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
