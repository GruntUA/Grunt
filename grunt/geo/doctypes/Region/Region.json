{
  "name": "Region",
  "label": "Регіон",
  "module": "geo",
  "autoname": "field:title",
  "title_field": "title",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "title",
      "label": "Назва",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "bold": true
    },
    {
      "fieldname": "title_uk",
      "label": "Назва (укр.)",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "country",
      "label": "Країна",
      "fieldtype": "Link",
      "options": "Country",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "code",
      "label": "Код ISO 3166-2",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "Код підрозділу (UA-30 для Києва, US-CA для Каліфорнії)"
    },
    {
      "fieldname": "region_type",
      "label": "Тип",
      "fieldtype": "Select",
      "options": "\nОбласть\nШтат\nПровінція\nЗемля\nРегіон\nКантон\nДепартамент\nІнше",
      "in_filter": true
    },
    {
      "fieldname": "is_active",
      "label": "Активний",
      "fieldtype": "Check",
      "default": "1",
      "in_filter": true
    }
  ],
  "default_view": "list",

  "search_fields": ["title", "title_uk", "code"],
  "permissions": [
    { "role": "All", "read": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "delete": true }
  ]
}
