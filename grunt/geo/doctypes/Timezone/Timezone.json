{
  "name": "Timezone",
  "label": "Timezone",
  "module": "geo",
  "autoname": "field:iana_id",
  "title_field": "label",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "iana_id",
      "label": "IANA identifier",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "For example: Europe/Kyiv, America/New_York"
    },
    {
      "fieldname": "label",
      "label": "Display name",
      "fieldtype": "Text",
      "in_list_view": true,
      "description": "For example: (UTC+2) Kyiv"
    },
    {
      "fieldname": "offset_minutes",
      "label": "Offset (minutes)",
      "fieldtype": "Int",
      "in_list_view": true,
      "description": "Offset from UTC in minutes (+120 for UTC+2, -300 for UTC-5)"
    },
    {
      "fieldname": "is_dst_observed",
      "label": "Daylight saving time",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_filter": true
    }
  ],
  "default_view": "list",
  "search_fields": [
    "iana_id",
    "label"
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
