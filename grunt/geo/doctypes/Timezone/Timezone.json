{
  "name": "Timezone",
  "label": "Часовий пояс",
  "module": "geo",
  "autoname": "field:iana_id",
  "title_field": "label",
  "track_changes": false,
  "fields": [
    {
      "fieldname": "iana_id",
      "label": "IANA-ідентифікатор",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "Наприклад: Europe/Kyiv, America/New_York"
    },
    {
      "fieldname": "label",
      "label": "Відображувана назва",
      "fieldtype": "Text",
      "in_list_view": true,
      "description": "Наприклад: (UTC+2) Київ"
    },
    {
      "fieldname": "offset_minutes",
      "label": "Зсув (хвилини)",
      "fieldtype": "Int",
      "in_list_view": true,
      "description": "Зсув від UTC у хвилинах (+120 для UTC+2, -300 для UTC-5)"
    },
    {
      "fieldname": "is_dst_observed",
      "label": "Перехід на літній час",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "is_active",
      "label": "Активний",
      "fieldtype": "Check",
      "default": "1",
      "in_filter": true
    }
  ],
  "default_view": "list",
  "search_fields": ["iana_id", "label"],
  "permissions": [
    { "role": "All", "read": true },
    { "role": "System Manager", "read": true, "write": true, "create": true, "delete": true }
  ]
}
