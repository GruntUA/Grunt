# English translations for Grunt Framework.
#
# Source strings here are Ukrainian (DocType labels, Select options, some UI
# text). Entries are context-free on purpose: pgettext() falls back to a plain
# lookup, so "Назва" → "Name" once covers every meta:<DocType>.<field> context.
# Add specific msgctxt entries only where a field needs a different wording.
#
msgid ""
msgstr ""
"Project-Id-Version: Grunt 0.1.0\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

