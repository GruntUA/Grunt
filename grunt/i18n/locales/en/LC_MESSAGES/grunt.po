#: grunt/grunt/site/doctypes/AppMenu/AppMenu.json
msgctxt "help:AppMenu.sections"
msgid ""
"Icons of the sidebar sections (shown in the modules style). A section not "
"listed here takes the icon of its first item"
msgstr ""

#: grunt/grunt/site/doctypes/AppMenu/AppMenu.json
msgctxt "help:AppMenu.sidebar_style"
msgid ""
"Sections - collapsible groups of items. Modules - one row per section, its "
"items open in a panel beside the sidebar. Auto - modules once the app has as"
" many sections as set in System settings"
msgstr ""

#: grunt/grunt/tasks/doctypes/BackgroundJob/BackgroundJob.json
msgctxt "help:BackgroundJob"
msgid ""
"Tasks a worker currently holds (delivered, not yet acknowledged) — a live "
"snapshot from the Redis Stream, nothing is stored in the DB. A task that "
"reports progress (e.g. a backup) shows its percent and current stage. "
"Finished tasks are not shown here; see the Error Log for failures."
msgstr ""

#: grunt/grunt/tasks/doctypes/BackgroundJob/BackgroundJob.json
msgctxt "help:BackgroundJob.progress"
msgid "Only for tasks that report progress; empty for the rest."
msgstr ""

#: grunt/grunt/backups/doctypes/Backup/Backup.json
msgctxt "help:Backup"
msgid ""
"Site backups in sites/<site>/backups/: database, uploaded files, "
"configuration. Schedule and number of copies — in System Settings → Backups."
" Copies in cloud storage — Cloud Storage."
msgstr ""

#: grunt/grunt/backups/doctypes/Backup/Backup.json
msgctxt "help:Backup.in_cloud"
msgid ""
"Cloud storages holding a copy of this set (Cloud Storage → «Upload backups "
"here»)."
msgstr ""

#: grunt/grunt/activity/doctypes/CommentReaction/CommentReaction.json
msgctxt "help:CommentReaction"
msgid ""
"A user's emoji reaction on one comment (the chips under comments in the "
"timeline)."
msgstr ""

#: grunt/grunt/metadata/doctypes/DocType/DocType.json
msgctxt "help:DocType.is_signable"
msgid ""
"Documents can be signed with a qualified electronic signature (needs an "
"e-signature app, e.g. esign)"
msgstr ""

#: grunt/grunt/storage/doctypes/File/File.json
msgctxt "help:File.is_compressed"
msgid ""
"The image was re-encoded on upload to take less space (System Settings → "
"Files); the original was not kept."
msgstr ""

#: grunt/grunt/storage/doctypes/File/File.json
msgctxt "help:File.storage_remote"
msgid ""
"The contents were moved off the server disk into this storage; they are "
"fetched back on request (grunt.storage.cloud.files)."
msgstr ""

#: grunt/grunt/site/doctypes/FormTour/FormTour.json
msgctxt "help:FormTour"
msgid ""
"A walk through a DocType's form: each step points at a field or an element "
"and explains it."
msgstr ""

#: grunt/grunt/site/doctypes/FormTour/FormTour.json
msgctxt "help:FormTour.auto_start"
msgid ""
"Starts the first time a user opens the form; afterwards - from the form's "
"menu"
msgstr ""

#: grunt/grunt/site/doctypes/FormTour/FormTour.json
msgctxt "help:FormTour.is_standard"
msgid "Ships with the app as JSON files - edits are saved to the app"
msgstr ""

#: grunt/grunt/site/doctypes/FormTour/FormTour.json
msgctxt "help:FormTour.roles"
msgid "Who sees the tour; empty - everyone. System Manager always does"
msgstr ""

#: grunt/grunt/site/doctypes/FormTourStep/FormTourStep.json
msgctxt "help:FormTourStep.element"
msgid ""
"Or a CSS selector of another element, e.g. [data-action=save]; neither - a "
"step in the middle of the screen"
msgstr ""

#: grunt/grunt/site/doctypes/FormTourStep/FormTourStep.json
msgctxt "help:FormTourStep.fieldname"
msgid "The form field to point at; its tab opens by itself"
msgstr ""

#: grunt/grunt/site/doctypes/ModuleOnboarding/ModuleOnboarding.json
msgctxt "help:ModuleOnboarding"
msgid ""
"A \"first steps\" checklist shown on an app's home and on the desk home "
"until its steps are done."
msgstr ""

#: grunt/grunt/site/doctypes/ModuleOnboarding/ModuleOnboarding.json
msgctxt "help:ModuleOnboarding.app"
msgid "Shown on this app's home; on the desk home in any case"
msgstr ""

#: grunt/grunt/site/doctypes/ModuleOnboarding/ModuleOnboarding.json
msgctxt "help:ModuleOnboarding.is_standard"
msgid "Ships with the app as JSON files - edits are saved to the app"
msgstr ""

#: grunt/grunt/site/doctypes/ModuleOnboarding/ModuleOnboarding.json
msgctxt "help:ModuleOnboarding.progress_scope"
msgid ""
"Site - one shared checklist (system setup). User - everyone goes through it "
"on their own (a step counts their own records)"
msgstr ""

#: grunt/grunt/site/doctypes/ModuleOnboarding/ModuleOnboarding.json
msgctxt "help:ModuleOnboarding.roles"
msgid "Who sees the checklist; empty - everyone. System Manager always does"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingProgress/OnboardingProgress.json
msgctxt "help:OnboardingProgress"
msgid ""
"Steps marked done or skipped, checklists hidden, form tours taken - for the "
"site or per user."
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingProgress/OnboardingProgress.json
msgctxt "help:OnboardingProgress.form_tour"
msgid "A tour the user has been through (instead of a checklist)"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingProgress/OnboardingProgress.json
msgctxt "help:OnboardingProgress.step_id"
msgid "Empty - the whole checklist (hidden)"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingProgress/OnboardingProgress.json
msgctxt "help:OnboardingProgress.user"
msgid "Empty - the site's progress"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingStep/OnboardingStep.json
msgctxt "help:OnboardingStep.action"
msgid ""
"Create Entry and Update Settings complete by themselves once the record "
"exists or the setting is filled in; the others - when opened"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingStep/OnboardingStep.json
msgctxt "help:OnboardingStep.field"
msgid "Settings field that has to be filled in"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingStep/OnboardingStep.json
msgctxt "help:OnboardingStep.reference_doctype"
msgid "Go to Page - opens this DocType instead of an address"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingStep/OnboardingStep.json
msgctxt "help:OnboardingStep.route"
msgid "Desk path (/app/...) or a full URL"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingStep/OnboardingStep.json
msgctxt "help:OnboardingStep.step_id"
msgid ""
"Keeps the step's progress when the checklist changes; set from the title"
msgstr ""

#: grunt/grunt/site/doctypes/OnboardingStep/OnboardingStep.json
msgctxt "help:OnboardingStep.value_to_validate"
msgid "Empty or % - any non-empty value"
msgstr ""

#: grunt/grunt/site/doctypes/Page/Page.json
msgctxt "help:Page.app"
msgid "A published page of an app is offered as a dashboard on the app's home"
msgstr ""

#: grunt/grunt/site/doctypes/PageWidget/PageWidget.json
msgctxt "help:PageWidget.period_switch"
msgid ""
"Let viewers switch the period (week/month/year/all time) on the widget "
"itself"
msgstr ""

#: grunt/grunt/tasks/doctypes/ScheduledJobLog/ScheduledJobLog.json
msgctxt "help:ScheduledJobLog"
msgid ""
"One row per scheduled job run - framework tasks, app scheduler_events and "
"Scheduler Event server scripts. Old entries are deleted automatically."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote"
msgid ""
"Connections to external storage (Google Drive, Dropbox, OneDrive, MEGA, S3, "
"WebDAV/Nextcloud, SFTP, SMB) through rclone: backup copies and moving old "
"files off the server disk."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.authorize"
msgid ""
"Needs your own Client ID and secret. Opens the provider's sign-in page and "
"returns here."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.backup_keep"
msgid ""
"Older sets in this storage are deleted after each upload; independent of how"
" many are kept on the server."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.browse_backups"
msgid ""
"Lists the sets in the storage; the chosen one is downloaded to the server "
"and appears in Backups, ready for «grunt db restore»."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.cache_size_mb"
msgid ""
"Files fetched back from the storage are kept on the server up to this size; "
"the least recently used are dropped at night."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.client_id"
msgid ""
"Optional: your own OAuth app (Google Cloud console / Dropbox App Console / "
"Microsoft Entra). Its redirect URI must be https://<your "
"site>/api/v1/method/grunt.storage.cloud.oauth.callback"
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.client_secret"
msgid "A saved secret is not shown again — to change it, enter a new one."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.encrypt"
msgid ""
"File contents are encrypted on the server (rclone crypt, XSalsa20-Poly1305) — the cloud keeps only ciphertext. Names stay readable.\n"
"\n"
"Keep the password somewhere outside this system (or use «rclone config»): without it no backup can be restored, and the password itself lives in the database you will be restoring."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.encryption_password"
msgid "Changing it later makes everything already uploaded unreadable."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.encryption_salt"
msgid "Optional, recommended. Same rules as the password."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.endpoint"
msgid ""
"WebDAV — the server URL (Nextcloud: "
"https://<server>/remote.php/dav/files/<user>/). S3 — endpoint; empty for "
"AWS."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.oauth_account"
msgid "Empty — not connected yet. Connect with one of the buttons below."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.offload_after_days"
msgid "Files uploaded earlier than this are moved by the nightly job (04:00)."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.offload_doctypes"
msgid ""
"DocType names, one per line, whose attachments are moved. Empty — any file, "
"including the library and personal files."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.offload_min_size_kb"
msgid "0 — any size. Small files cost a request each and save little space."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.offload_public"
msgid ""
"Website images are better kept on the server: they are read all the time."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.password"
msgid ""
"Nextcloud — better an app password (Settings → Security). A saved password "
"is not shown again — to change it, enter a new one."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.paste_token"
msgid ""
"The simplest way, no app registration needed: on any computer with a browser"
" install rclone and run the command shown in the dialog (e.g. rclone "
"authorize \"drive\"), sign in, then paste the printed token here. Leave "
"Client ID empty."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.port"
msgid "Empty — the standard one (SFTP 22, SMB 445)."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.provider"
msgid ""
"S3 — Amazon, Cloudflare R2, Backblaze, Wasabi, MinIO and other S3-compatible"
" storage. WebDAV — Nextcloud, ownCloud and the like. SMB — a Windows/NAS "
"network share. Server folder — a mounted disk or NAS on this server. Other —"
" any rclone backend (https://rclone.org/overview/)."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.rclone_options"
msgid ""
"Extra backend options, one «key = value» per line; they override the "
"generated ones. Option names — in the backend's page on rclone.org."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.rclone_type"
msgid ""
"Name from https://rclone.org/overview/ (pcloud, yandex, b2, box, koofr…)."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.recall_files"
msgid ""
"Downloads every file kept in this storage back to the server disk (check the"
" free space first)."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.root_folder"
msgid ""
"Everything is kept under this folder: backups/<site>/ and files/<site>/. For"
" S3 — bucket/path (e.g. my-bucket/grunt); for SMB — share/path; for a server"
" folder — an absolute path (/mnt/nas/grunt)."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.sec_backups"
msgid ""
"Every new backup set (System Settings → Backups) is uploaded to each storage"
" with this option, right after it is made, into <root "
"folder>/backups/<site>/."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.sec_files"
msgid ""
"Moves the contents of rarely used files off the server disk. The File "
"record, previews and access rules stay; on the first request the file is "
"fetched back into a local cache. Only one storage can hold files."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.secret_access_key"
msgid "A saved secret is not shown again — to change it, enter a new one."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.show_config"
msgid ""
"The same storage as an rclone.conf section — keep it outside the system to "
"get backups back with plain rclone if the server is lost."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.ssh_private_key"
msgid ""
"Instead of a password: the PEM key (-----BEGIN OPENSSH PRIVATE KEY----- …). "
"Not shown again after saving."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.test_connection"
msgid ""
"Creates the root folder, writes and deletes a small test file. Save your "
"changes first."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.title"
msgid "How this storage is shown in lists and in the backup status."
msgstr ""

#: grunt/grunt/storage/doctypes/StorageRemote/StorageRemote.json
msgctxt "help:StorageRemote.username"
msgid "MEGA — the account email."
msgstr ""

#: grunt/grunt/monitoring/doctypes/SystemHealthReport/SystemHealthReport.json
msgctxt "help:SystemHealthReport.browser_report"
msgid ""
"Run in the browser this page is opened in: service worker, offline cache, "
"queue of unsynced changes, storage."
msgstr ""

