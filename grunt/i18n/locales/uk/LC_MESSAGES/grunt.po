#: grunt/grunt/tasks/doctypes/AutoRepeat/AutoRepeat.json
msgctxt "help:AutoRepeat"
msgid ""
"Creates copies of a document on a schedule (monthly invoices, recurring "
"orders, reminders)"
msgstr ""
"Створює копії документа за розкладом (щомісячні рахунки, регулярні "
"замовлення, нагадування)"

#: grunt/grunt/tasks/doctypes/AutoRepeat/AutoRepeat.json
msgctxt "help:AutoRepeat.date_field"
msgid ""
"Fieldname of a Date/Datetime field in the copy to set to the scheduled date "
"(e.g. posting_date)"
msgstr ""
"Назва поля типу Date/Datetime у копії, яке отримає дату за розкладом (напр. "
"posting_date)"

#: grunt/grunt/tasks/doctypes/AutoRepeat/AutoRepeat.json
msgctxt "help:AutoRepeat.end_date"
msgid "Empty: repeat until disabled"
msgstr "Порожньо — повторювати, доки не вимкнено"

#: grunt/grunt/tasks/doctypes/AutoRepeat/AutoRepeat.json
msgctxt "help:AutoRepeat.notify"
