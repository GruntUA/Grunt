msgctxt "meta:SystemSettings"
msgid "System settings"
msgstr "Налаштування системи"

msgctxt "meta:SystemSettings.tab_general"
msgid "General"
msgstr "Загальні"

msgctxt "meta:SystemSettings.app_name"
msgid "App name"
msgstr "Назва додатку"

msgctxt "help:SystemSettings.app_name"
msgid "Shown in the browser tab title, the sidebar and system emails."
msgstr ""
"Відображається у заголовку вкладки браузера, боковому меню та системних "
"листах."

msgctxt "meta:SystemSettings.app_logo"
msgid "Logo"
msgstr "Логотип"

msgctxt "help:SystemSettings.app_logo"
msgid "PNG or SVG. Shown in the sidebar and on the login page."
msgstr "PNG або SVG. Показується у боковому меню та на сторінці входу."

msgctxt "meta:SystemSettings.sec_regional"
msgid "Regional settings"
msgstr "Регіональні налаштування"

msgctxt "meta:SystemSettings.language"
msgid "Default language"
msgstr "Мова за замовчуванням"

msgctxt "help:SystemSettings.language"
msgid "UI language for new users."
msgstr "Мова інтерфейсу для нових користувачів."

msgctxt "meta:SystemSettings.timezone"
msgid "Time zone"
msgstr "Часовий пояс"

msgctxt "help:SystemSettings.timezone"
msgid "Used to display dates and times."
msgstr "Використовується для відображення дат і часу."

msgctxt "meta:SystemSettings.date_format"
msgid "Date format"
msgstr "Формат дати"

msgctxt "meta:SystemSettings.sec_registration"
msgid "User registration"
msgstr "Реєстрація користувачів"

msgctxt "meta:SystemSettings.allow_user_registration"
msgid "Allow self sign-up"
msgstr "Дозволити самостійну реєстрацію"

msgctxt "help:SystemSettings.allow_user_registration"
msgid "Shows the sign-up form on the login page."
msgstr "Показує форму реєстрації на сторінці входу."

msgctxt "meta:SystemSettings.require_signup_approval"
msgid "Registration needs approval"
msgstr "Реєстрація потребує підтвердження"

msgctxt "help:SystemSettings.require_signup_approval"
msgid ""
"A new user cannot sign in until an administrator approves their "
"registration."
msgstr ""
"Новий користувач не зможе увійти, доки адміністратор не підтвердить його "
"реєстрацію."

msgctxt "meta:SystemSettings.default_role"
msgid "Default role"
msgstr "Роль за замовчуванням"

msgctxt "help:SystemSettings.default_role"
msgid "Assigned to the user right after self sign-up."
msgstr "Призначається користувачу одразу після самостійної реєстрації."

msgctxt "meta:SystemSettings.sec_maintenance"
msgid "Logs & maintenance"
msgstr "Журнали та обслуговування"

msgctxt "meta:SystemSettings.log_retention_days"
msgid "Keep logs, days"
msgstr "Зберігати журнали, днів"

msgctxt "help:SystemSettings.log_retention_days"
msgid ""
"Log records (errors, background jobs, views, etc.) older than this many days"
" are deleted automatically every day. An individual DocType may override "
"this with its own setting."
msgstr ""
"Записи журналів (помилки, фонові завдання, перегляди тощо) старші за вказану"
" кількість днів видаляються автоматично щодоби. Окремий DocType може "
"перевизначити це значення власним параметром."

msgctxt "meta:SystemSettings.tab_security"
msgid "Security"
msgstr "Безпека"

msgctxt "meta:SystemSettings.sec_password"
msgid "Password policy"
msgstr "Політика паролів"

msgctxt "meta:SystemSettings.password_min_length"
msgid "Minimum password length"
msgstr "Мінімальна довжина пароля"

msgctxt "help:SystemSettings.password_min_length"
msgid "Applied when a password is created or changed."
msgstr "Застосовується при створенні або зміні пароля."

msgctxt "meta:SystemSettings.password_require_uppercase"
msgid "Uppercase letters (A–Z)"
msgstr "Великі літери (A–Z)"

msgctxt "meta:SystemSettings.password_require_lowercase"
msgid "Lowercase letters (a–z)"
msgstr "Малі літери (a–z)"

msgctxt "meta:SystemSettings.password_require_numbers"
msgid "Digits (0–9)"
msgstr "Цифри (0–9)"

msgctxt "meta:SystemSettings.password_require_symbols"
msgid "Special characters"
msgstr "Спеціальні символи"

msgctxt "meta:SystemSettings.sec_sessions"
msgid "Sessions & brute-force protection"
msgstr "Сесії та захист від підбору"

msgctxt "meta:SystemSettings.session_timeout"
msgid "Session lifetime, min"
msgstr "Час життя сесії, хв"

msgctxt "help:SystemSettings.session_timeout"
msgid "After how many minutes of inactivity a re-login is required."
msgstr "Через скільки хвилин бездіяльності потрібен повторний вхід."

msgctxt "meta:SystemSettings.max_login_attempts"
msgid "Max login attempts"
msgstr "Максимум спроб входу"

msgctxt "help:SystemSettings.max_login_attempts"
msgid "Number of failed attempts before a temporary lockout."
msgstr "Кількість невдалих спроб до тимчасового блокування."

msgctxt "meta:SystemSettings.account_lockout_duration"
msgid "Lockout duration, min"
msgstr "Тривалість блокування, хв"

msgctxt "meta:SystemSettings.sec_user_permissions"
msgid "Access restrictions (User Permissions)"
msgstr "Обмеження доступу (User Permissions)"

msgctxt "meta:SystemSettings.apply_strict_user_permissions"
msgid "Strict user permissions"
msgstr "Суворі обмеження користувача"

msgctxt "help:SystemSettings.apply_strict_user_permissions"
msgid ""
"When enabled, a document with no Link field to the restricted type (or with "
"an empty value) is hidden rather than shown."
msgstr ""
"Якщо увімкнено — документ без Link-поля на обмежений тип (або з порожнім "
"значенням) приховується, а не показується."

msgctxt "meta:SystemSettings.default_email_account"
msgid "Default account"
msgstr "Обліковий запис за замовчуванням"

msgctxt "help:SystemSettings.default_email_account"
msgid "Used for outgoing mail when no sender is set explicitly."
msgstr ""
"Використовується для вихідних листів, коли відправника не вказано явно."

msgctxt "meta:SystemSettings.email_footer"
msgid "Email signature"
msgstr "Підпис у листах"

msgctxt "help:SystemSettings.email_footer"
msgid "Appended to the end of every outgoing email."
msgstr "Додається в кінець кожного вихідного листа."

msgctxt "meta:SystemSettings.tab_notifications"
msgid "Notifications"
msgstr "Сповіщення"

msgctxt "meta:SystemSettings.sec_webpush"
msgid "Web Push (browser notifications)"
msgstr "Web Push (сповіщення браузера)"

msgctxt "meta:SystemSettings.enable_web_push"
msgid "Enable push notifications"
msgstr "Увімкнути push-сповіщення"

msgctxt "help:SystemSettings.enable_web_push"
msgid "Lets users subscribe to browser notifications."
msgstr "Дозволяє користувачам підписуватися на сповіщення в браузері."

msgctxt "help:SystemSettings.webpush_vapid_public"
msgid ""
"Generated automatically on the first Web Push run. Clients need it to "
"subscribe."
msgstr ""
"Генерується автоматично при першому запуску Web Push. Потрібен клієнтам для "
"підписки."

