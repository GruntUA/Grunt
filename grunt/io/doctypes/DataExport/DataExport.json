{
  "name": "DataExport",
  "label": "Data Export",
  "module": "io",
  "title_field": "doctype_name",
  "fields": [
    {
      "fieldname": "doctype_name",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Data",
      "in_list_view": true
    },
    {
      "fieldname": "export_format",
      "label": "Format",
      "fieldtype": "Select",
      "options": "csv\nxlsx",
      "default": "xlsx",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "fields_to_export",
      "label": "Fields to export",
      "fieldtype": "JSON",
      "description": "Array of fieldnames. If empty — all fields."
    },
    {
      "fieldname": "filters",
      "label": "Filters",
      "fieldtype": "JSON",
      "description": "JSON object: {\"fieldname\": \"value\"}"
    },
    {
      "fieldname": "limit",
      "label": "Max rows",
      "fieldtype": "Int",
      "default": 10000
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending\nIn Progress\nSuccess\nFailed",
      "translatable": true,
      "default": "Pending",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "exported_rows",
      "label": "Rows exported",
      "fieldtype": "Int",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "file",
      "label": "Result file",
      "fieldtype": "Attach",
      "read_only": true,
      "description": "Filled in automatically after export"
    },
    {
      "fieldname": "error",
      "label": "Error",
      "fieldtype": "Text",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
