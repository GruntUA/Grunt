{
  "name": "DataImport",
  "label": "Data Import",
  "module": "io",
  "title_field": "doctype_name",
  "fields": [
    {
      "fieldname": "doctype_name",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "file",
      "label": "File (CSV / XLSX)",
      "fieldtype": "Attach",
      "required": true
    },
    {
      "fieldname": "import_type",
      "label": "Import type",
      "fieldtype": "Select",
      "options": "Insert New\nUpdate Existing",
      "translatable": true,
      "default": "Insert New",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "update_key",
      "label": "Update key",
      "fieldtype": "Data",
      "depends_on": "eval:doc.import_type === 'Update Existing'",
      "description": "Field used to find an existing document"
    },
    {
      "fieldname": "mapping",
      "label": "Column mapping",
      "fieldtype": "ColumnMapping"
    },
    {
      "fieldname": "dry_run",
      "label": "Validate only (no writes)",
      "fieldtype": "Check",
      "default": true
    },
    {
      "fieldname": "skip_required_validation",
      "label": "Skip required fields",
      "fieldtype": "Check",
      "default": false,
      "description": "Allows importing rows even if required fields are empty"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending\nIn Progress\nSuccess\nPartial Success\nFailed",
      "translatable": true,
      "default": "Pending",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "total_rows",
      "label": "Total rows",
      "fieldtype": "Int",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "processed_rows",
      "label": "Processed",
      "fieldtype": "Int",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "error_count",
      "label": "Errors",
      "fieldtype": "Int",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "error_log",
      "label": "Error log",
      "fieldtype": "JSON",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
