      "description": "Зберігати версії документа при кожному збереженні"
    },
    {
      "fieldname": "sec_views",
      "label": "Вигляди (Views JSON)",
      "fieldtype": "Section"
    },
    {
      "fieldname": "list_view",
      "label": "Налаштування списку",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "form_view",
