{
  "name": "DocTypeCalendarSource",
  "label": "Calendar source",
  "module": "metadata",
  "is_child": true,
  "fields": [
    {
      "fieldname": "doctype",
      "label": "DocType",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "description": "The document type added to the calendar as a separate source"
    },
    {
      "fieldname": "date_field",
      "label": "Date field",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "description": "Fieldname on the source DocType holding the event date"
    },
    {
      "fieldname": "end_date_field",
      "label": "End date field",
      "fieldtype": "Data"
    },
    {
      "fieldname": "label_field",
      "label": "Label field",
      "fieldtype": "Data",
      "description": "Fieldname for the event label (default: name)"
    },
    {
      "fieldname": "color",
      "label": "Colour",
      "fieldtype": "Data",
      "in_list_view": true,
      "description": "#hex or var(--…)"
    },
    {
      "fieldname": "event_type",
      "label": "Event type",
      "fieldtype": "Select",
      "options": "default\nbirthday",
      "default": "default",
      "in_list_view": true
    },
    {
      "fieldname": "recurring",
      "label": "Yearly",
      "fieldtype": "Check",
      "in_list_view": true
    },
    {
      "fieldname": "show_age",
      "label": "Show age",
      "fieldtype": "Check",
      "description": "For birthday events — appends (N years) to the label"
    },
    {
      "fieldname": "filters",
      "label": "Filters (JSON)",
      "fieldtype": "JSON",
      "description": "{ \"status\": \"Active\" }"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
