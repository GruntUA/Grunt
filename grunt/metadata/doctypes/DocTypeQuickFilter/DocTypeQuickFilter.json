{
  "name": "DocTypeQuickFilter",
  "label": "Швидкий фільтр",
  "module": "metadata",
  "is_child": true,
  "fields": [
    {
      "fieldname": "id",
      "label": "ID",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "description": "Унікальний у межах DocType; використовується як префікс ключа запиту"
    },
    {
      "fieldname": "field",
      "label": "Поле",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "description": "Fieldname на цьому DocType"
    },
    {
      "fieldname": "operator",
      "label": "Оператор",
      "fieldtype": "Select",
      "options": "eq\nne\nneq\nilike\nlike\ngt\nlt\ngte\nlte\nin\nisnull\nlte_or_null",
      "default": "eq",
      "in_list_view": true
    },
    {
      "fieldname": "label",
      "label": "Підпис",
      "fieldtype": "Data",
      "description": "Якщо порожньо — береться підпис поля"
    },
    {
      "fieldname": "input_type",
      "label": "Тип вводу",
      "fieldtype": "Select",
      "options": "text\ndate\nselect\ncheck\nnumber\nlink",
      "default": "text",
      "in_list_view": true
    },
    {
      "fieldname": "default_value",
      "label": "Значення за замовчуванням",
      "fieldtype": "Data"
    },
    {
      "fieldname": "options",
      "label": "Варіанти (JSON)",
      "fieldtype": "JSON",
      "description": "Явний список варіантів select; перекриває field.options"
    },
    {
      "fieldname": "enabled_in",
      "label": "Активний у",
      "fieldtype": "JSON",
      "default": "[\"list\", \"tree\"]",
      "description": "[\"list\", \"tree\"] — де показувати фільтр"
    },
    {
      "fieldname": "on_change",
      "label": "On change (JSON)",
      "fieldtype": "JSON",
      "description": "{\"mode\": \"local\", \"debounce_ms\": 300} або {\"mode\": \"external\", \"source\": \"...\"}"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
