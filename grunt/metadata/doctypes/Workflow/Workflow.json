{
  "name": "Workflow",
  "label": "Workflow",
  "module": "metadata",
  "standard_records": true,
  "title_field": "document_type",
  "fields": [
    {
      "fieldname": "tab_main",
      "label": "General",
      "fieldtype": "Tab",
      "icon": "settings"
    },
    {
      "fieldname": "document_type",
      "label": "DocType",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true
    },
    {
      "fieldname": "workflow_state_field",
      "label": "State field",
      "fieldtype": "Text",
      "default": "status",
      "required": true,
      "description": "Name of the field on the target DocType that stores the current state"
    },
    {
      "fieldname": "tab_list",
      "label": "States & transitions",
      "fieldtype": "Tab",
      "icon": "list"
    },
    {
      "fieldname": "states",
      "label": "States",
      "fieldtype": "Table",
      "options": "WorkflowState"
    },
    {
      "fieldname": "transitions",
      "label": "Transitions",
      "fieldtype": "Table",
      "options": "WorkflowTransition"
    },
    {
      "fieldname": "positions",
      "label": "Node positions",
      "fieldtype": "JSON",
      "hidden": true,
      "description": "Graph node coordinates {state: {x, y}} — managed by the Graph tab"
    },
    {
      "fieldname": "is_standard",
      "label": "Standard",
      "fieldtype": "Check",
      "in_list_view": true,
      "in_filter": true,
      "description": "Ships with the app as JSON files - edits are saved to the app"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp",
      "depends_on": "is_standard",
      "mandatory_depends_on": "is_standard"
    },
    {
      "fieldname": "tab_graph",
      "label": "Graph",
      "fieldtype": "Tab",
      "icon": "git-branch",
      "tab_component": "WorkflowGraphTab"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
