{
  "name": "Workflow",
  "label": "Workflow",
  "module": "metadata",
  "title_field": "document_type",
  "fields": [
    {
      "fieldname": "tab_main",
      "label": "Основне",
      "fieldtype": "Tab",
      "icon": "settings"
    },
    {
      "fieldname": "document_type",
      "label": "DocType",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_active",
      "label": "Активний",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true
    },
    {
      "fieldname": "workflow_state_field",
      "label": "Поле стану",
      "fieldtype": "Text",
      "default": "status",
      "required": true,
      "description": "Назва поля цільового DocType, у якому зберігається поточний стан"
    },
    {
      "fieldname": "tab_list",
      "label": "Стани і переходи",
      "fieldtype": "Tab",
      "icon": "list"
    },
    {
      "fieldname": "states",
      "label": "Стани",
      "fieldtype": "Table",
      "options": "WorkflowState"
    },
    {
      "fieldname": "transitions",
      "label": "Переходи",
      "fieldtype": "Table",
      "options": "WorkflowTransition"
    },
    {
      "fieldname": "positions",
      "label": "Позиції вузлів",
      "fieldtype": "JSON",
      "hidden": true,
      "description": "Координати вузлів графа {state: {x, y}} — керується вкладкою Граф"
    },
    {
      "fieldname": "tab_graph",
      "label": "Граф",
      "fieldtype": "Tab",
      "icon": "git-branch",
      "tab_component": "WorkflowGraphTab"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
