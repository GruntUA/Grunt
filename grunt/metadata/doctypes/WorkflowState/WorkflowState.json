{
  "name": "WorkflowState",
  "label": "Workflow state",
  "module": "metadata",
  "is_child": true,
  "fields": [
    {
      "fieldname": "state",
      "label": "Value",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "description": "The value stored in the target document's state field"
    },
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "color",
      "label": "Colour",
      "fieldtype": "Select",
      "options": "gray\nblue\ngreen\nyellow\norange\nred",
      "default": "gray",
      "in_list_view": true
    },
    {
      "fieldname": "is_initial",
      "label": "Initial",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "is_final",
      "label": "Final",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "edit_roles",
      "label": "Edit roles (comma-separated)",
      "fieldtype": "LongText",
      "description": "Who may edit or delete the document in this state (workflow actions are not affected). Empty — everyone with write permission"
    },
    {
      "fieldname": "update_field",
      "label": "Set field",
      "fieldtype": "Text",
      "description": "On entering this state, write “Field value” into this field of the document (e.g. published)"
    },
    {
      "fieldname": "update_value",
      "label": "Field value",
      "fieldtype": "Text",
      "depends_on": "eval:doc.update_field"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
