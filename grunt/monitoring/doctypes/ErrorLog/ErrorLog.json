{
  "name": "ErrorLog",
  "label": "Error Log",
  "module": "monitoring",
  "icon": "bug",
  "is_log": true,
  "track_activity": false,
  "track_changes": false,
  "track_seen": true,
  "autoname": "hash",
  "title_field": "title",
  "default_view": "list",
  "search_fields": [
    "error_type",
    "method",
    "user"
  ],
  "description": "Unhandled framework and app errors — HTTP requests, background tasks, controllers. Old entries are deleted automatically (see System Settings → Maintenance).",
  "fields": [
    {
      "fieldname": "title",
      "label": "Error",
      "fieldtype": "Data",
      "read_only": true,
      "in_list_view": true,
      "max_length": 200
    },
    {
      "fieldname": "error_type",
      "label": "Type",
      "fieldtype": "Data",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true,
      "index": true
    },
    {
      "fieldname": "context",
      "label": "Context",
      "fieldtype": "Select",
      "options": "HTTP Request\nBackground Task\nScheduled Job\nController\nManual",
      "translatable": true,
      "read_only": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Data",
      "read_only": true,
      "in_filter": true,
      "index": true
    },
    {
      "fieldname": "method",
      "label": "Method / route",
      "fieldtype": "Data",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Data",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true,
      "index": true
    },
    {
      "fieldname": "sec_request",
      "label": "HTTP request",
      "fieldtype": "Section",
      "collapsible": true,
      "depends_on": "eval: doc.context == 'HTTP Request'"
    },
    {
      "fieldname": "request_method",
      "label": "HTTP method",
      "fieldtype": "Data",
      "read_only": true,
      "columns": 3
    },
    {
      "fieldname": "http_status",
      "label": "Response code",
      "fieldtype": "Int",
      "read_only": true,
      "columns": 3
    },
    {
      "fieldname": "request_path",
      "label": "Path",
      "fieldtype": "Data",
      "read_only": true,
      "columns": 6
    },
    {
      "fieldname": "request_id",
      "label": "Request ID",
      "fieldtype": "Data",
      "read_only": true,
      "columns": 6
    },
    {
      "fieldname": "sec_reference",
      "label": "Document",
      "fieldtype": "Section",
      "collapsible": true,
      "depends_on": "eval: doc.reference_doctype"
    },
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": true,
      "in_filter": true,
      "columns": 6
    },
    {
      "fieldname": "reference_name",
      "label": "Document",
      "fieldtype": "Data",
      "read_only": true,
      "columns": 6
    },
    {
      "fieldname": "sec_details",
      "label": "Details",
      "fieldtype": "Section"
    },
    {
      "fieldname": "error_message",
      "label": "Message",
      "fieldtype": "Code",
      "read_only": true
    },
    {
      "fieldname": "traceback",
      "label": "Stack trace",
      "fieldtype": "Code",
      "options": "python",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "delete": true
    }
  ]
}
