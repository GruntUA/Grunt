{
  "name": "SystemHealthReport",
  "label": "System Health",
  "module": "monitoring",
  "icon": "heart-pulse",
  "is_virtual": true,
  "is_singleton": true,
  "track_changes": false,
  "track_activity": false,
  "status_field": "overall_status",
  "status_indicators": [
    {
      "value": "OK",
      "color": "success",
      "label": "All good"
    },
    {
      "value": "Warning",
      "color": "warn",
      "label": "Has warnings"
    },
    {
      "value": "Error",
      "color": "danger",
      "label": "Has problems"
    }
  ],
  "description": "Diagnostics: database, background tasks, scheduler, errors, email, security, files and offline mode. Computed live on every open — nothing is stored.",
  "fields": [
    {
      "fieldname": "tab_server",
      "label": "Server",
      "fieldtype": "Tab"
    },
    {
      "fieldname": "overall_status",
      "label": "Overall status",
      "fieldtype": "Select",
      "options": "OK\nWarning\nError",
      "translatable": true,
      "read_only": true
    },
    {
      "fieldname": "checked_at",
      "label": "Checked",
      "fieldtype": "Datetime",
      "read_only": true
    },
    {
      "fieldname": "col_summary",
      "fieldtype": "Column"
    },
    {
      "fieldname": "ok_count",
      "label": "Good",
      "fieldtype": "Int",
      "read_only": true
    },
    {
      "fieldname": "warning_count",
      "label": "Warning",
      "fieldtype": "Int",
      "read_only": true
    },
    {
      "fieldname": "error_count",
      "label": "Problems",
      "fieldtype": "Int",
      "read_only": true
    },
    {
      "fieldname": "sec_checks",
      "label": "Checks",
      "fieldtype": "Section"
    },
    {
      "fieldname": "checks",
      "label": "Checks",
      "fieldtype": "Table",
      "options": "SystemHealthCheck",
      "group_by": "category",
      "read_only": true
    },
    {
      "fieldname": "sec_details",
      "label": "Details",
      "fieldtype": "Section"
    },
    {
      "fieldname": "top_errors",
      "label": "Most frequent errors (7 days)",
      "fieldtype": "Table",
      "options": "SystemHealthItem",
      "read_only": true
    },
    {
      "fieldname": "col_details",
      "fieldtype": "Column"
    },
    {
      "fieldname": "largest_tables",
      "label": "Largest tables",
      "fieldtype": "Table",
      "options": "SystemHealthItem",
      "read_only": true
    },
    {
      "fieldname": "tab_browser",
      "label": "Browser and offline",
      "fieldtype": "Tab"
    },
    {
      "fieldname": "browser_checks",
      "label": "Checks of this browser",
      "fieldtype": "Table",
      "options": "SystemHealthCheck",
      "group_by": "category",
      "read_only": true,
      "description": "Run in the browser this page is opened in: service worker, offline cache, queue of unsynced changes, storage."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true
    }
  ]
}
