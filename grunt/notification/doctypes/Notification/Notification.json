{
  "name": "Notification",
  "label": "Notification",
  "module": "notification",
  "standard_records": true,
  "table_name": "grunt_notification",
  "fields": [
    {
      "fieldname": "sec_when",
      "label": "When",
      "fieldtype": "Section"
    },
    {
      "fieldname": "ref_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "event",
      "label": "Event",
      "fieldtype": "Select",
      "options": "after_insert\nafter_save\non_transition\nvalue_change\ndays_before\ndays_after",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "col_when",
      "fieldtype": "Column"
    },
    {
      "fieldname": "date_field",
      "label": "Date field",
      "fieldtype": "Data",
      "depends_on": "eval: ['days_before', 'days_after'].includes(doc.event)",
      "mandatory_depends_on": "eval: ['days_before', 'days_after'].includes(doc.event)",
      "description": "Date/Datetime field of the document the reminder is counted from, e.g. contract_end"
    },
    {
      "fieldname": "days",
      "label": "Days",
      "fieldtype": "Int",
      "default": 0,
      "min_value": 0,
      "depends_on": "eval: ['days_before', 'days_after'].includes(doc.event)",
      "description": "How many days before/after the date; 0: on the day itself. Sent once a day at 08:00"
    },
    {
      "fieldname": "every_year",
      "label": "Every year",
      "fieldtype": "Check",
      "default": false,
      "depends_on": "eval: ['days_before', 'days_after'].includes(doc.event)",
      "description": "Match only day and month - birthdays, work anniversaries"
    },
    {
      "fieldname": "condition",
      "label": "Condition",
      "fieldtype": "LongText",
      "description": "Python expression on doc and user, e.g. doc.status == 'Open'. Empty: always"
    },
    {
      "fieldname": "sec_who",
      "label": "Recipients",
      "fieldtype": "Section"
    },
    {
      "fieldname": "recipients",
      "label": "Recipients",
      "fieldtype": "Table",
      "options": "NotificationRecipient",
      "required": true
    },
    {
      "fieldname": "notify_actor",
      "label": "Also notify who did it",
      "fieldtype": "Check",
      "default": false,
      "description": "By default the user whose action triggered the notification is not notified"
    },
    {
      "fieldname": "sec_what",
      "label": "Message",
      "fieldtype": "Section"
    },
    {
      "fieldname": "subject_template",
      "label": "Subject",
      "fieldtype": "Data",
      "default": "{{ doctype }}: {{ doc.name }}",
      "description": "Jinja: {{ doc.field }}, {{ doctype }}, {{ event }}, {{ actor }} (who did it), {{ url }}; on a workflow transition also {{ action }}, {{ from_state }}, {{ to_state }}, {{ comment }}"
    },
    {
      "fieldname": "message_template",
      "label": "Message",
      "fieldtype": "LongText",
      "default": "{{ doctype }} {{ doc.name }}: {{ event }}",
      "description": "Jinja, same variables as the subject"
    },
    {
      "fieldname": "sec_channels",
      "label": "Channels",
      "fieldtype": "Section"
    },
    {
      "fieldname": "channels",
      "label": "Channels",
      "fieldtype": "Table",
      "options": "NotificationChannel",
      "required": true
    },
    {
      "fieldname": "sec_meta",
      "label": "Settings",
      "fieldtype": "Section"
    },
    {
      "fieldname": "is_enabled",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "col_meta",
      "fieldtype": "Column"
    },
    {
      "fieldname": "is_standard",
      "label": "Standard",
      "fieldtype": "Check",
      "in_list_view": true,
      "in_filter": true,
      "description": "Ships with the app as JSON files - edits are saved to the app"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp",
      "depends_on": "is_standard",
      "mandatory_depends_on": "is_standard"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "actions": [
        "read",
        "write",
        "create",
        "delete",
        "export",
        "import",
        "print",
        "share",
        "report"
      ]
    }
  ],
  "description": "When something happens to a document, who is told, what and through which channels"
}
