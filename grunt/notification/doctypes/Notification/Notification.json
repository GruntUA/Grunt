{
  "name": "Notification",
  "label": "Message",
  "module": "notification",
  "track_changes": false,
  "table_name": "grunt_notification",
  "track_activity": false,
  "track_deletions": false,
  "fields": [
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "index": true
    },
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "message",
      "label": "Message",
      "fieldtype": "LongText",
      "required": true
    },
    {
      "fieldname": "ref_doctype",
      "label": "Document type",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "doc_id",
      "label": "Document ID",
      "fieldtype": "Text"
    },
    {
      "fieldname": "is_read",
      "label": "Read",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true,
      "in_filter": true,
      "index": true
    },
    {
      "fieldname": "notification_rule",
      "label": "Notification Rule",
      "fieldtype": "Link",
      "options": "NotificationRule",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "write": true,
      "delete": true,
      "match": "user == user"
    }
  ],
  "indexes": [
    [
      "notification_rule",
      "doc_id"
    ]
  ]
}
