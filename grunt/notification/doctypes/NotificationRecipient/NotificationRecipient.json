      "mandatory_depends_on": "eval: doc.kind == 'Role'"
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "in_list_view": true,
      "depends_on": "eval: doc.kind == 'User'",
      "mandatory_depends_on": "eval: doc.kind == 'User'"
    },
    {
      "fieldname": "field",
      "label": "Field",
      "fieldtype": "Data",
      "in_list_view": true,
      "depends_on": "eval: doc.kind == 'Document field'",
      "mandatory_depends_on": "eval: doc.kind == 'Document field'",
