    },
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data",
      "in_list_view": true,
      "depends_on": "eval: doc.kind == 'Email'",
      "mandatory_depends_on": "eval: doc.kind == 'Email'"
