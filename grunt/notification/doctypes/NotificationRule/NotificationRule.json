{
  "name": "NotificationRule",
  "label": "Notification Rule",
  "module": "notification",
  "standard_records": true,
  "table_name": "grunt_notification_rule",
  "fields": [
    {
      "fieldname": "ref_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "event",
      "label": "Event",
      "fieldtype": "Select",
      "options": "after_insert\nafter_save\non_transition\nvalue_change",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "channel",
      "label": "Channel",
      "fieldtype": "Select",
      "options": "system\nemail\nboth",
      "translatable": true,
      "default": "system",
      "in_list_view": true
    },
    {
      "fieldname": "recipients",
      "label": "Recipients",
      "fieldtype": "Text",
      "required": true
    },
    {
      "fieldname": "condition",
      "label": "Condition (Python)",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "subject_template",
      "label": "Subject template",
      "fieldtype": "Text",
      "default": "{doctype}: {name}"
    },
    {
      "fieldname": "message_template",
      "label": "Message template",
      "fieldtype": "LongText",
      "default": "{doctype} {name} was {event}"
    },
    {
      "fieldname": "is_enabled",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_standard",
      "label": "Standard",
      "fieldtype": "Check",
      "in_list_view": true,
      "in_filter": true,
      "description": "Ships with the app as JSON files - edits are saved to the app"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp",
      "depends_on": "is_standard",
      "mandatory_depends_on": "is_standard"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
