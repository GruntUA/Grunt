{
  "name": "SharedWith",
  "label": "Access",
  "module": "permissions",
  "indexes": [
    [
      "reference_doctype",
      "reference_id"
    ]
  ],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true
    },
    {
      "fieldname": "reference_id",
      "label": "Document ID",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "permission",
      "label": "Permission",
      "fieldtype": "Select",
      "options": "Read\nWrite",
      "translatable": true,
      "default": "Read"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "actions": ["write", "create", "delete"]
    },
    {
      "role": "All",
      "actions": ["read"],
      "match": "user == user"
    },
    {
      "role": "All",
      "actions": ["read"],
      "match": "owner == user"
    },
    {
      "role": "System Manager",
      "actions": ["read", "write", "create", "delete", "export", "import", "print", "share", "report"]
    }
  ],
  "description": "Per-user share of one document (Read / Write). Only someone who can write the document may share it."
}
