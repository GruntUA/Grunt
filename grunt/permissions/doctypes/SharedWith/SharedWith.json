{
  "name": "SharedWith",
  "label": "Access",
  "module": "permissions",
  "inherit_permission_from": [
    [
      "reference_doctype",
      "reference_id"
    ]
  ],
  "indexes": [
    [
      "reference_doctype",
      "reference_id"
    ]
  ],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true
    },
    {
      "fieldname": "reference_id",
      "label": "Document ID",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Data",
      "description": "One user (their email)"
    },
    {
      "fieldname": "role",
      "label": "Role",
      "fieldtype": "Link",
      "options": "Role",
      "description": "Everyone holding the role today"
    },
    {
      "fieldname": "everyone",
      "label": "Everyone",
      "fieldtype": "Check",
      "default": 0,
      "description": "Every signed-in user"
    },
    {
      "fieldname": "permission",
      "label": "Permission",
      "fieldtype": "Select",
      "options": "Read\nWrite",
      "translatable": true,
      "default": "Read"
    },
    {
      "fieldname": "can_reshare",
      "label": "Can share further",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "valid_to",
      "label": "Valid until",
      "fieldtype": "Date",
      "description": "Inclusive; empty - no end"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "actions": [
        "read",
        "write",
        "create",
        "delete"
      ]
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "write",
        "create",
        "delete",
        "export",
        "import",
        "print",
        "share",
        "report"
      ]
    }
  ],
  "description": "A share of one document with a user, a role or everyone (Read / Write, until a date, may share further). Readable by whoever can read the document; only someone allowed to share it at that level can share it."
}
