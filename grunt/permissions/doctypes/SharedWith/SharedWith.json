{
  "name": "SharedWith",
  "label": "Доступ",
  "module": "permissions",
  "indexes": [
    [
      "reference_doctype",
      "reference_id"
    ]
  ],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Тип документа",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true
    },
    {
      "fieldname": "reference_id",
      "label": "ID документа",
      "fieldtype": "Text",
      "required": true
    },
    {
      "fieldname": "user",
      "label": "Користувач",
      "fieldtype": "Text",
      "required": true
    },
    {
      "fieldname": "permission",
      "label": "Дозвіл",
      "fieldtype": "Select",
      "options": "Read\nWrite",
      "translatable": true,
      "default": "Read"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "create": true,
      "write": true,
      "delete": true
    },
    {
      "role": "All",
      "read": true,
      "match": "user == user"
    },
    {
      "role": "All",
      "read": true,
      "match": "owner == user"
    },
    {
      "role": "System Manager",
      "read": true,
      "create": true,
      "write": true,
      "delete": true
    }
  ],
  "description": "Per-user share of one document (Read / Write). Only someone who can write the document may share it."
}
