{
  "name": "UserPermission",
  "label": "User Permission",
  "module": "permissions",
  "autoname": "hash",
  "title_field": "for_user",
  "fields": [
    {
      "fieldname": "for_user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User",
      "required": true,
      "index": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "allow",
      "label": "Restrict by",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "description": "Document type to restrict access by (e.g. «Company»)."
    },
    {
      "fieldname": "for_value",
      "label": "Value",
      "fieldtype": "DynamicLink",
      "options": "allow",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "description": "The allowed record. The user will see only documents linked to it."
    },
    {
      "fieldname": "col_scope",
      "fieldtype": "Column"
    },
    {
      "fieldname": "apply_to_all_doctypes",
      "label": "Apply to all documents",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "description": "The restriction applies to any DocType with a Link field to «Restrict by»."
    },
    {
      "fieldname": "applicable_for",
      "label": "For document only",
      "fieldtype": "Link",
      "options": "DocType",
      "depends_on": "eval:!doc.apply_to_all_doctypes",
      "description": "Limit this rule to a single DocType."
    },
    {
      "fieldname": "is_default",
      "label": "Default value",
      "fieldtype": "Check",
      "default": false,
      "description": "Fill this value into the matching Link field of new documents."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
