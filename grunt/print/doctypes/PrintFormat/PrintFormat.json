{
  "name": "PrintFormat",
  "label": "Формат друку",
  "module": "print",
  "table_name": "grunt_print_format",
  "fields": [
    {
      "fieldname": "doctype",
      "label": "Тип документа",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "template_type",
      "label": "Тип шаблону",
      "fieldtype": "Select",
      "options": "html\ndocx",
      "default": "html",
      "in_list_view": true
    },
    {
      "fieldname": "is_default",
      "label": "За замовчуванням",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "is_app_format",
      "label": "Зберігати в додатку",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "app",
      "label": "Додаток",
      "fieldtype": "Link",
      "options": "GruntInstalledApp"
    },
    {
      "fieldname": "sec_template",
      "label": "Шаблон Jinja2 + HTML",
      "fieldtype": "Section"
    },
    {
      "fieldname": "template",
      "label": "Шаблон",
      "fieldtype": "Code",
      "options": "html",
      "required": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
