{
  "name": "PrintFormat",
  "label": "Print Format",
  "module": "print",
  "table_name": "grunt_print_format",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "template_type",
      "label": "Template type",
      "fieldtype": "Select",
      "options": "html\ndocx",
      "default": "html",
      "in_list_view": true
    },
    {
      "fieldname": "is_default",
      "label": "Default",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "is_app_format",
      "label": "Save in app",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp"
    },
    {
      "fieldname": "sec_template",
      "label": "Jinja2 + HTML template",
      "fieldtype": "Section"
    },
    {
      "fieldname": "template",
      "label": "Template",
      "fieldtype": "Code",
      "options": "html",
      "required": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
