{
  "name": "Dashboard",
  "label": "Dashboard",
  "module": "reports",
  "hide_from_activity_feed": true,
  "is_child": false,
  "autoname": "prompt",
  "title_field": "label",
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Text"
    },
    {
      "fieldname": "workspace",
      "label": "Workspace",
      "fieldtype": "Text",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_published",
      "label": "Published",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "roles",
      "label": "Roles (comma-separated)",
      "fieldtype": "Text"
    },
    {
      "fieldname": "widgets",
      "label": "Widgets",
      "fieldtype": "Table",
      "options": "Dashboard Widget"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
