{
  "name": "DashboardChart",
  "label": "Графік дашборду",
  "module": "reports",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "chart_type",
      "label": "Тип графіка",
      "fieldtype": "Select",
      "options": "bar\nline\npie\ndonut",
      "default": "bar",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "doctype",
      "label": "Тип документа",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "value_field",
      "label": "Поле значення",
      "fieldtype": "Text",
      "required": true
    },
    {
      "fieldname": "group_by",
      "label": "Групувати за",
      "fieldtype": "Text"
    },
    {
      "fieldname": "timespan",
      "label": "Період",
      "fieldtype": "Select",
      "options": "last_week\nlast_month\nlast_quarter\nlast_year\nall_time",
      "translatable": true,
      "default": "last_year",
      "in_list_view": true
    },
    {
      "fieldname": "filters",
      "label": "Фільтри (JSON)",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "color",
      "label": "Колір",
      "fieldtype": "Text",
      "default": "#2D6A4F"
    },
    {
      "fieldname": "is_public",
      "label": "Публічний",
      "fieldtype": "Check",
      "default": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
