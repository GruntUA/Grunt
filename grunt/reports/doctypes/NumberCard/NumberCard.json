{
  "name": "NumberCard",
  "label": "Number Card",
  "module": "reports",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "aggregation",
      "label": "Aggregation",
      "fieldtype": "Select",
      "options": "count\nsum\navg\nmin\nmax",
      "translatable": true,
      "default": "count",
      "in_list_view": true
    },
    {
      "fieldname": "value_field",
      "label": "Value field",
      "fieldtype": "Text"
    },
    {
      "fieldname": "filters",
      "label": "Filters (JSON)",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "color",
      "label": "Color",
      "fieldtype": "Text",
      "default": "#2D6A4F"
    },
    {
      "fieldname": "icon",
      "label": "Icon",
      "fieldtype": "Text"
    },
    {
      "fieldname": "is_public",
      "label": "Public",
      "fieldtype": "Check",
      "default": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
