{
  "name": "Report",
  "label": "Звіт",
  "module": "reports",
  "track_changes": false,
  "table_name": "grunt_report",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "report_name",
      "label": "Назва",
      "fieldtype": "Text",
      "required": true,
      "unique": true,
      "in_list_view": true
    },
    {
      "fieldname": "report_type",
      "label": "Тип",
      "fieldtype": "Select",
      "options": "Query\nScript\nList",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "doctype",
      "label": "Тип документа",
      "fieldtype": "Link",
      "options": "DocType",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "columns",
      "label": "Колонки (JSON)",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "filters_config",
      "label": "Конфігурація фільтрів (JSON)",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "chart_config",
      "label": "Конфігурація графіка (JSON)",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "sec_query",
      "label": "SQL запит",
      "fieldtype": "Section",
      "depends_on": "eval:doc.report_type==='Query'"
    },
    {
      "fieldname": "query",
      "label": "SQL",
      "fieldtype": "Code",
      "options": "sql",
      "depends_on": "eval:doc.report_type==='Query'"
    },
    {
      "fieldname": "sec_script",
      "label": "Python скрипт",
      "fieldtype": "Section",
      "depends_on": "eval:doc.report_type==='Script'"
    },
    {
      "fieldname": "script",
      "label": "Скрипт",
      "fieldtype": "Code",
      "options": "python",
      "depends_on": "eval:doc.report_type==='Script'"
    },
    {
      "fieldname": "sec_schedule",
      "label": "Scheduled delivery",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "schedule_frequency",
      "label": "Send",
      "fieldtype": "Select",
      "options": "\nDaily\nWeekly\nMonthly",
      "description": "Email the report as XLSX on a schedule (daily at 07:00). Empty — off."
    },
    {
      "fieldname": "schedule_recipients",
      "label": "Recipients",
      "fieldtype": "LongText",
      "depends_on": "schedule_frequency",
      "mandatory_depends_on": "schedule_frequency",
      "description": "Email addresses, comma-separated or one per line."
    },
    {
      "fieldname": "schedule_filters",
      "label": "Filters",
      "fieldtype": "JSON",
      "depends_on": "schedule_frequency",
      "description": "Report filters for the scheduled run, e.g. {\"status\": \"Open\"}."
    },
    {
      "fieldname": "last_sent_at",
      "label": "Last sent",
      "fieldtype": "Datetime",
      "read_only": true,
      "depends_on": "schedule_frequency"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ],
  "actions": [
    {
      "action": "report.send_now",
      "condition": "doc.schedule_recipients"
    }
  ]
}
