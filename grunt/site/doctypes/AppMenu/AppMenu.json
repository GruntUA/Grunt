{
  "name": "AppMenu",
  "label": "App menu",
  "module": "site",
  "is_child": false,
  "autoname": "prompt",
  "title_field": "label",
  "table_name": "grunt_workspace",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "icon",
      "label": "Icon",
      "fieldtype": "Icon",
      "in_list_view": true
    },
    {
      "fieldname": "color",
      "label": "Colour",
      "fieldtype": "Color",
      "default": "#2D6A4F"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Text"
    },
    {
      "fieldname": "sequence",
      "label": "Order",
      "fieldtype": "Int",
      "default": 0
    },
    {
      "fieldname": "is_hidden",
      "label": "Hidden",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "roles",
      "label": "Roles (comma-separated)",
      "fieldtype": "Text"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp"
    },
    {
      "fieldname": "home_page",
      "label": "Home page",
      "fieldtype": "Link",
      "options": "Page"
    },
    {
      "fieldname": "sidebar_style",
      "label": "Sidebar style",
      "fieldtype": "Select",
      "options": "Auto\nSections\nModules",
      "translatable": true,
      "default": "Auto",
      "description": "Sections - collapsible groups of items. Modules - one row per section, its items open in a panel beside the sidebar. Auto - modules once the app has as many sections as set in System settings"
    },
    {
      "fieldname": "sections",
      "label": "Sections",
      "fieldtype": "Table",
      "options": "WorkspaceSection",
      "description": "Icons of the sidebar sections (shown in the modules style). A section not listed here takes the icon of its first item"
    },
    {
      "fieldname": "sidebar_items",
      "label": "Sidebar items",
      "fieldtype": "Table",
      "options": "WorkspaceSidebarItem"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
