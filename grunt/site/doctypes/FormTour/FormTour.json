{
  "name": "FormTour",
  "label": "Form tour",
  "description": "A walk through a DocType's form or list: each step points at a field or an element and explains it.",
  "module": "site",
  "standard_records": true,
  "hide_from_activity_feed": true,
  "autoname": "prompt",
  "title_field": "title",
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "translatable": true
    },
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "view",
      "label": "Shown in",
      "fieldtype": "Select",
      "options": "Form\nList",
      "default": "Form",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "description": "Where the tour runs: the document's form or the list of documents"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp",
      "in_filter": true
    },
    {
      "fieldname": "is_published",
      "label": "Published",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true
    },
    {
      "fieldname": "auto_start",
      "label": "Start automatically",
      "fieldtype": "Check",
      "description": "Starts the first time a user opens the form (or the list); afterwards - from its menu"
    },
    {
      "fieldname": "roles",
      "label": "Roles (comma-separated)",
      "fieldtype": "Data",
      "description": "Who sees the tour; empty - everyone. System Manager always does"
    },
    {
      "fieldname": "steps",
      "label": "Steps",
      "fieldtype": "Table",
      "options": "FormTourStep"
    },
    {
      "fieldname": "is_standard",
      "label": "Standard",
      "fieldtype": "Check",
      "in_filter": true,
      "description": "Ships with the app as JSON files - edits are saved to the app"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "actions": ["read"]
    },
    {
      "role": "System Manager",
      "actions": ["write", "create", "delete", "import", "share"]
    }
  ]
}
