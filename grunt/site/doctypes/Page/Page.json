{
  "name": "Page",
  "label": "Page",
  "module": "site",
  "standard_records": true,
  "hide_from_activity_feed": true,
  "is_child": false,
  "autoname": "prompt",
  "title_field": "label",
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Text"
    },
    {
      "fieldname": "is_published",
      "label": "Published",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "roles",
      "label": "Roles (comma-separated)",
      "fieldtype": "Text"
    },
    {
      "fieldname": "widgets",
      "label": "Widgets",
      "fieldtype": "Table",
      "options": "PageWidget"
    },
    {
      "fieldname": "is_standard",
      "label": "Standard",
      "fieldtype": "Check",
      "in_list_view": true,
      "in_filter": true,
      "description": "Ships with the app as JSON files - edits are saved to the app"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp",
      "depends_on": "is_standard",
      "mandatory_depends_on": "is_standard"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true
    },
    {
      "role": "System Manager",
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
