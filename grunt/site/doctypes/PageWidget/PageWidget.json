{
  "name": "PageWidget",
  "label": "Page widget",
  "module": "site",
  "hide_from_activity_feed": true,
  "is_child": true,
  "title_field": "title",
  "fields": [
    {
      "fieldname": "widget_type",
      "label": "Type",
      "fieldtype": "Select",
      "options": "metric\ngauge\nchart_area\nchart_bar\ndonut\nlist\nshortcut\nshortcuts_grid\ntext\nclock\nactivity\ncalendar\nheatmap\nfunnel\ntable",
      "required": true,
      "in_list_view": true,
      "default": "metric"
    },
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "ref_doctype",
      "label": "DocType",
      "fieldtype": "Text"
    },
    {
      "fieldname": "aggregation",
      "label": "Aggregation",
      "fieldtype": "Select",
      "options": "count\nsum\navg\nmin\nmax",
      "translatable": true,
      "default": "count"
    },
    {
      "fieldname": "field",
      "label": "Field",
      "fieldtype": "Text"
    },
    {
      "fieldname": "value_label",
      "label": "Value label",
      "fieldtype": "Text",
      "description": "Heading of the value column (default: the aggregation, e.g. Sum)"
    },
    {
      "fieldname": "row_limit",
      "label": "Rows",
      "fieldtype": "Int",
      "description": "How many rows the table shows (default 20)"
    },
    {
      "fieldname": "group_by",
      "label": "Group by",
      "fieldtype": "Text"
    },
    {
      "fieldname": "date_field",
      "label": "Date field",
      "fieldtype": "Text"
    },
    {
      "fieldname": "period",
      "label": "Period",
      "fieldtype": "Select",
      "options": "7d\n30d\n90d\n365d",
      "default": "30d"
    },
    {
      "fieldname": "filters",
      "label": "Filters",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "min_value",
      "label": "Min. value",
      "fieldtype": "Int",
      "default": 0
    },
    {
      "fieldname": "max_value",
      "label": "Max. value",
      "fieldtype": "Int",
      "default": 100
    },
    {
      "fieldname": "cols",
      "label": "Width (1-4)",
      "fieldtype": "Int",
      "default": 1
    },
    {
      "fieldname": "color",
      "label": "Colour",
      "fieldtype": "Select",
      "options": "primary\nblue\namber\nred\nviolet\ncyan",
      "default": "primary"
    },
    {
      "fieldname": "icon",
      "label": "Icon (lucide)",
      "fieldtype": "Text"
    },
    {
      "fieldname": "sequence",
      "label": "Order",
      "fieldtype": "Int",
      "default": 0
    },
    {
      "fieldname": "link_type",
      "label": "Link type",
      "fieldtype": "Select",
      "options": "DocType\nReport\nPage\nURL",
      "translatable": true
    },
    {
      "fieldname": "description",
      "label": "Description / Subtitle",
      "fieldtype": "Text"
    },
    {
      "fieldname": "report",
      "label": "Report (chart data source)",
      "fieldtype": "Text"
    },
    {
      "fieldname": "content",
      "label": "Content",
      "fieldtype": "LongText"
    }
  ]
}
