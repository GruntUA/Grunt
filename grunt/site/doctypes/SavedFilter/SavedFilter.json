{
  "name": "SavedFilter",
  "label": "Saved filter",
  "description": "A named set of list filters - its owner's, or shared with roles or with everyone (only to apply; the owner changes and deletes it). An app ships its own as standard records.",
  "module": "site",
  "autoname": "hash",
  "standard_records": true,
  "title_field": "title",
  "track_activity": false,
  "hide_from_activity_feed": true,
  "in_global_search": false,
  "indexes": [["ref_doctype", "shared_with"], ["owner", "ref_doctype"]],
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "ref_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "filters",
      "label": "Filters",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "shared_with",
      "label": "Shared with",
      "fieldtype": "Select",
      "options": "Nobody\nRoles\nEveryone",
      "default": "Nobody",
      "translatable": true,
      "in_list_view": true
    },
    {
      "fieldname": "roles",
      "label": "Roles",
      "fieldtype": "JSON",
      "description": "Role names, when shared with roles",
      "depends_on": "eval:doc.shared_with == 'Roles'"
    },
    {
      "fieldname": "is_standard",
      "label": "Standard",
      "fieldtype": "Check",
      "in_filter": true,
      "description": "Ships with the app as JSON files - edits are saved to the app"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp",
      "depends_on": "is_standard",
      "mandatory_depends_on": "is_standard"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "actions": ["read", "write", "create", "delete"],
      "match": "owner == user"
    }
  ]
}
