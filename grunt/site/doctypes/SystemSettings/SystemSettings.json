{
  "name": "SystemSettings",
  "label": "Налаштування системи",
  "module": "site",
  "is_singleton": true,
  "icon": "Settings2",
  "form_view": {
    "layout": "compact"
  },
  "fields": [
    {
      "fieldname": "tab_general",
      "label": "Загальні",
      "fieldtype": "Tab",
      "icon": "settings"
    },

    {
      "fieldname": "sec_identity",
      "label": "",
      "fieldtype": "Section"
    },
    {
      "fieldname": "col_identity_left",
      "fieldtype": "Column"
    },
    {
      "fieldname": "app_name",
      "label": "Назва додатку",
      "fieldtype": "Text",
      "required": true,
      "default": "Grunt Framework",
      "bold": true,
      "description": "Відображається у заголовку вкладки браузера, боковому меню та системних листах."
    },
    {
      "fieldname": "col_identity_right",
      "fieldtype": "Column"
    },
    {
      "fieldname": "app_logo",
      "label": "Логотип",
      "fieldtype": "Image",
      "description": "PNG або SVG. Показується у боковому меню та на сторінці входу."
    },

    {
      "fieldname": "sec_regional",
      "label": "Регіональні налаштування",
      "fieldtype": "Section"
    },
    {
      "fieldname": "language",
      "label": "Мова за замовчуванням",
      "fieldtype": "Select",
      "options": "uk-UA\nen-US",
      "default": "uk-UA",
      "columns": 6,
      "description": "Мова інтерфейсу для нових користувачів."
    },
    {
      "fieldname": "timezone",
      "label": "Часовий пояс",
      "fieldtype": "Select",
      "options": "Europe/Kyiv\nUTC",
      "default": "Europe/Kyiv",
      "columns": 6,
      "description": "Використовується для відображення дат і часу."
    },
    {
      "fieldname": "date_format",
      "label": "Формат дати",
      "fieldtype": "Select",
      "options": "dd.mm.yyyy\ndd/mm/yyyy\nyyyy-mm-dd",
      "default": "dd.mm.yyyy",
      "columns": 6
    },

    {
      "fieldname": "sec_registration",
      "label": "Реєстрація користувачів",
      "fieldtype": "Section"
    },
    {
      "fieldname": "allow_user_registration",
      "label": "Дозволити самостійну реєстрацію",
      "fieldtype": "Check",
      "default": false,
      "columns": 12,
      "description": "Показує форму реєстрації на сторінці входу."
    },
    {
      "fieldname": "default_role",
      "label": "Роль за замовчуванням",
      "fieldtype": "Link",
      "options": "Role",
      "columns": 6,
      "depends_on": "eval: doc.allow_user_registration",
      "mandatory_depends_on": "eval: doc.allow_user_registration",
      "description": "Призначається користувачу одразу після самостійної реєстрації."
    },

    {
      "fieldname": "tab_security",
      "label": "Безпека",
      "fieldtype": "Tab",
      "icon": "shield-check"
    },

    {
      "fieldname": "sec_password",
      "label": "Політика паролів",
      "fieldtype": "Section"
    },
    {
      "fieldname": "password_min_length",
      "label": "Мінімальна довжина пароля",
      "fieldtype": "Int",
      "default": 8,
      "min_value": 4,
      "max_value": 128,
      "columns": 6,
      "description": "Застосовується при створенні або зміні пароля."
    },
    {
      "fieldname": "password_require_uppercase",
      "label": "Великі літери (A–Z)",
      "fieldtype": "Check",
      "default": true,
      "columns": 6
    },
    {
      "fieldname": "password_require_lowercase",
      "label": "Малі літери (a–z)",
      "fieldtype": "Check",
      "default": true,
      "columns": 6
    },
    {
      "fieldname": "password_require_numbers",
      "label": "Цифри (0–9)",
      "fieldtype": "Check",
      "default": true,
      "columns": 6
    },
    {
      "fieldname": "password_require_symbols",
      "label": "Спеціальні символи",
      "fieldtype": "Check",
      "default": false,
      "columns": 6
    },

    {
      "fieldname": "sec_sessions",
      "label": "Сесії та захист від підбору",
      "fieldtype": "Section"
    },
    {
      "fieldname": "session_timeout",
      "label": "Час життя сесії, хв",
      "fieldtype": "Int",
      "default": 480,
      "min_value": 5,
      "columns": 6,
      "description": "Через скільки хвилин бездіяльності потрібен повторний вхід."
    },
    {
      "fieldname": "max_login_attempts",
      "label": "Максимум спроб входу",
      "fieldtype": "Int",
      "default": 5,
      "min_value": 1,
      "columns": 6,
      "description": "Кількість невдалих спроб до тимчасового блокування."
    },
    {
      "fieldname": "account_lockout_duration",
      "label": "Тривалість блокування, хв",
      "fieldtype": "Int",
      "default": 30,
      "min_value": 1,
      "columns": 6
    },

    {
      "fieldname": "tab_email",
      "label": "Email",
      "fieldtype": "Tab",
      "icon": "mail"
    },

    {
      "fieldname": "sec_email",
      "label": "",
      "fieldtype": "Section"
    },
    {
      "fieldname": "default_email_account",
      "label": "Обліковий запис за замовчуванням",
      "fieldtype": "Link",
      "options": "EmailAccount",
      "columns": 6,
      "description": "Використовується для вихідних листів, коли відправника не вказано явно."
    },
    {
      "fieldname": "email_footer",
      "label": "Підпис у листах",
      "fieldtype": "RichText",
      "columns": 12,
      "description": "Додається в кінець кожного вихідного листа."
    },

    {
      "fieldname": "tab_notifications",
      "label": "Сповіщення",
      "fieldtype": "Tab",
      "icon": "bell"
    },

    {
      "fieldname": "sec_webpush",
      "label": "Web Push (сповіщення браузера)",
      "fieldtype": "Section"
    },
    {
      "fieldname": "enable_web_push",
      "label": "Увімкнути push-сповіщення",
      "fieldtype": "Check",
      "default": false,
      "columns": 12,
      "description": "Дозволяє користувачам підписуватися на сповіщення в браузері."
    },
    {
      "fieldname": "webpush_vapid_public",
      "label": "VAPID Public Key",
      "fieldtype": "Text",
      "read_only": true,
      "columns": 12,
      "description": "Генерується автоматично при першому запуску Web Push. Потрібен клієнтам для підписки."
    },
    {
      "fieldname": "webpush_vapid_private",
      "label": "VAPID Private Key",
      "fieldtype": "LongText",
      "hidden": true
    },

    {
      "fieldname": "is_setup_complete",
      "label": "Систему налаштовано",
      "fieldtype": "Check",
      "default": false,
      "hidden": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
