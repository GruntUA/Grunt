{
  "name": "SystemSettings",
  "label": "System settings",
  "module": "site",
  "hide_from_activity_feed": true,
  "is_singleton": true,
  "icon": "Settings2",
  "fields": [
    {
      "fieldname": "tab_general",
      "label": "General",
      "fieldtype": "Tab",
      "icon": "settings"
    },
    {
      "fieldname": "sec_identity",
      "label": "",
      "fieldtype": "Section"
    },
    {
      "fieldname": "col_identity_left",
      "fieldtype": "Column"
    },
    {
      "fieldname": "app_name",
      "label": "App name",
      "fieldtype": "Text",
      "required": true,
      "default": "Grunt Framework",
      "bold": true,
      "description": "Shown in the browser tab title, the sidebar and system emails."
    },
    {
      "fieldname": "col_identity_right",
      "fieldtype": "Column"
    },
    {
      "fieldname": "app_logo",
      "label": "Logo",
      "fieldtype": "Image",
      "description": "PNG or SVG. Shown in the sidebar and on the login page."
    },
    {
      "fieldname": "sec_regional",
      "label": "Regional settings",
      "fieldtype": "Section"
    },
    {
      "fieldname": "language",
      "label": "Default language",
      "fieldtype": "Select",
      "default": "uk",
      "columns": 6,
      "description": "UI language for new users.",
      "options_source": "grunt.i18n.language"
    },
    {
      "fieldname": "timezone",
      "label": "Time zone",
      "fieldtype": "Select",
      "options": "Europe/Kyiv\nUTC",
      "default": "Europe/Kyiv",
      "columns": 6,
      "description": "Used to display dates and times."
    },
    {
      "fieldname": "date_format",
      "label": "Date format",
      "fieldtype": "Select",
      "options": "dd.mm.yyyy\ndd/mm/yyyy\nyyyy-mm-dd",
      "default": "dd.mm.yyyy",
      "columns": 6
    },
    {
      "fieldname": "sec_registration",
      "label": "User registration",
      "fieldtype": "Section"
    },
    {
      "fieldname": "allow_user_registration",
      "label": "Allow self sign-up",
      "fieldtype": "Check",
      "default": false,
      "columns": 12,
      "description": "Shows the sign-up form on the login page."
    },
    {
      "fieldname": "require_signup_approval",
      "label": "Registration needs approval",
      "fieldtype": "Check",
      "default": false,
      "columns": 12,
      "depends_on": "eval: doc.allow_user_registration",
      "description": "A new user cannot sign in until an administrator approves their registration."
    },
    {
      "fieldname": "default_role",
      "label": "Default role",
      "fieldtype": "Link",
      "options": "Role",
      "columns": 6,
      "depends_on": "eval: doc.allow_user_registration",
      "mandatory_depends_on": "eval: doc.allow_user_registration",
      "description": "Assigned to the user right after self sign-up."
    },
    {
      "fieldname": "sec_maintenance",
      "label": "Logs & maintenance",
      "fieldtype": "Section"
    },
    {
      "fieldname": "log_retention_days",
      "label": "Keep logs, days",
      "fieldtype": "Int",
      "default": 90,
      "min_value": 1,
      "max_value": 3650,
      "columns": 6,
      "description": "Log records (errors, background jobs, views, etc.) older than this many days are deleted automatically every day. An individual DocType may override this with its own setting."
    },
    {
      "fieldname": "tab_security",
      "label": "Security",
      "fieldtype": "Tab",
      "icon": "shield-check"
    },
    {
      "fieldname": "sec_password",
      "label": "Password policy",
      "fieldtype": "Section"
    },
    {
      "fieldname": "password_min_length",
      "label": "Minimum password length",
      "fieldtype": "Int",
      "default": 8,
      "min_value": 4,
      "max_value": 128,
      "columns": 6,
      "description": "Applied when a password is created or changed."
    },
    {
      "fieldname": "password_require_uppercase",
      "label": "Uppercase letters (A–Z)",
      "fieldtype": "Check",
      "default": true,
      "columns": 6
    },
    {
      "fieldname": "password_require_lowercase",
      "label": "Lowercase letters (a–z)",
      "fieldtype": "Check",
      "default": true,
      "columns": 6
    },
    {
      "fieldname": "password_require_numbers",
      "label": "Digits (0–9)",
      "fieldtype": "Check",
      "default": true,
      "columns": 6
    },
    {
      "fieldname": "password_require_symbols",
      "label": "Special characters",
      "fieldtype": "Check",
      "default": false,
      "columns": 6
    },
    {
      "fieldname": "sec_sessions",
      "label": "Sessions & brute-force protection",
      "fieldtype": "Section"
    },
    {
      "fieldname": "session_timeout",
      "label": "Session lifetime, min",
      "fieldtype": "Int",
      "default": 480,
      "min_value": 5,
      "columns": 6,
      "description": "After how many minutes of inactivity a re-login is required."
    },
    {
      "fieldname": "max_login_attempts",
      "label": "Max login attempts",
      "fieldtype": "Int",
      "default": 5,
      "min_value": 1,
      "columns": 6,
      "description": "Number of failed attempts before a temporary lockout."
    },
    {
      "fieldname": "account_lockout_duration",
      "label": "Lockout duration, min",
      "fieldtype": "Int",
      "default": 30,
      "min_value": 1,
      "columns": 6
    },
    {
      "fieldname": "sec_user_permissions",
      "label": "Access restrictions (User Permissions)",
      "fieldtype": "Section"
    },
    {
      "fieldname": "apply_strict_user_permissions",
      "label": "Strict user permissions",
      "fieldtype": "Check",
      "default": false,
      "description": "When enabled, a document with no Link field to the restricted type (or with an empty value) is hidden rather than shown."
    },
    {
      "fieldname": "tab_email",
      "label": "Email",
      "fieldtype": "Tab",
      "icon": "mail"
    },
    {
      "fieldname": "sec_email",
      "label": "",
      "fieldtype": "Section"
    },
    {
      "fieldname": "default_email_account",
      "label": "Default account",
      "fieldtype": "Link",
      "options": "EmailAccount",
      "columns": 6,
      "description": "Used for outgoing mail when no sender is set explicitly."
    },
    {
      "fieldname": "email_footer",
      "label": "Email signature",
      "fieldtype": "RichText",
      "columns": 12,
      "description": "Appended to the end of every outgoing email."
    },
    {
      "fieldname": "tab_backups",
      "label": "Backups",
      "fieldtype": "Tab",
      "icon": "archive"
    },
    {
      "fieldname": "sec_backups",
      "label": "Scheduled backups",
      "fieldtype": "Section",
      "description": "Database, uploaded files and site config are saved to sites/<site>/backups/. Backups are listed, downloaded and made on demand in «Backups»."
    },
    {
      "fieldname": "backup_enabled",
      "label": "Make backups automatically",
      "fieldtype": "Check",
      "default": true,
      "columns": 12
    },
    {
      "fieldname": "backup_interval_hours",
      "label": "Every, hours",
      "fieldtype": "Int",
      "default": 24,
      "min_value": 1,
      "max_value": 720,
      "columns": 4,
      "depends_on": "eval:doc.backup_enabled",
      "description": "24 = once a day."
    },
    {
      "fieldname": "backup_keep",
      "label": "Keep backups",
      "fieldtype": "Int",
      "default": 7,
      "min_value": 1,
      "max_value": 365,
      "columns": 4,
      "depends_on": "eval:doc.backup_enabled",
      "description": "Older ones are deleted after each new backup."
    },
    {
      "fieldname": "backup_include_files",
      "label": "Include uploaded files",
      "fieldtype": "Check",
      "default": true,
      "columns": 4,
      "depends_on": "eval:doc.backup_enabled"
    },
    {
      "fieldname": "backup_compression_level",
      "label": "Compression level",
      "fieldtype": "Int",
      "default": 9,
      "min_value": 1,
      "max_value": 19,
      "columns": 4,
      "description": "zstd, 1–19. Higher is smaller but slower: 9 is a good balance, 19 is the smallest. Also used by «Create now»."
    },
    {
      "fieldname": "tab_notifications",
      "label": "Notifications",
      "fieldtype": "Tab",
      "icon": "bell"
    },
    {
      "fieldname": "sec_webpush",
      "label": "Web Push (browser notifications)",
      "fieldtype": "Section"
    },
    {
      "fieldname": "enable_web_push",
      "label": "Enable push notifications",
      "fieldtype": "Check",
      "default": false,
      "columns": 12,
      "description": "Lets users subscribe to browser notifications."
    },
    {
      "fieldname": "webpush_vapid_public",
      "label": "VAPID Public Key",
      "fieldtype": "Text",
      "read_only": true,
      "columns": 12,
      "description": "Generated automatically on the first Web Push run. Clients need it to subscribe."
    },
    {
      "fieldname": "webpush_vapid_private",
      "label": "VAPID Private Key",
      "fieldtype": "LongText",
      "hidden": true
    },
    {
      "fieldname": "is_setup_complete",
      "label": "System configured",
      "fieldtype": "Check",
      "default": false,
      "hidden": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
