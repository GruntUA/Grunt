{
  "name": "WebForm",
  "label": "Web form",
  "module": "site",
  "table_name": "grunt_web_form",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "route",
      "label": "URL route",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "introduction",
      "label": "Introduction",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "success_message",
      "label": "Success message",
      "fieldtype": "Text",
      "default": "Дякуємо! Вашу заявку прийнято."
    },
    {
      "fieldname": "success_url",
      "label": "URL after submit",
      "fieldtype": "Text"
    },
    {
      "fieldname": "login_required",
      "label": "Login required",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "is_published",
      "label": "Published",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "max_submissions",
      "label": "Max responses",
      "fieldtype": "Int",
      "default": 0
    },
    {
      "fieldname": "submit_label",
      "label": "Button text",
      "fieldtype": "Text",
      "default": "Надіслати"
    },
    {
      "fieldname": "allow_edit",
      "label": "Allow editing",
      "fieldtype": "Check"
    },
    {
      "fieldname": "fields",
      "label": "Fields (JSON)",
      "fieldtype": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
