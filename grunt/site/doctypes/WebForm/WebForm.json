{
  "name": "WebForm",
  "label": "Web form",
  "module": "site",
  "standard_records": true,
  "table_name": "grunt_web_form",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "route",
      "label": "URL route",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "ref_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "introduction",
      "label": "Introduction",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "success_message",
      "label": "Success message",
      "fieldtype": "Text",
      "default": "Дякуємо! Вашу заявку прийнято."
    },
    {
      "fieldname": "success_url",
      "label": "URL after submit",
      "fieldtype": "Text"
    },
    {
      "fieldname": "login_required",
      "label": "Login required",
      "fieldtype": "Check",
      "default": false,
      "in_list_view": true
    },
    {
      "fieldname": "is_published",
      "label": "Published",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "max_submissions",
      "label": "Max responses",
      "fieldtype": "Int",
      "default": 0
    },
    {
      "fieldname": "submit_label",
      "label": "Button text",
      "fieldtype": "Text",
      "default": "Надіслати"
    },
    {
      "fieldname": "allow_edit",
      "label": "Allow editing",
      "fieldtype": "Check"
    },
    {
      "fieldname": "sec_notifications",
      "label": "Notifications",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "confirmation_template",
      "label": "Confirmation email template",
      "fieldtype": "Link",
      "options": "EmailTemplate",
      "description": "Sent to the submitter's own email field (if any) and to every address in Notify emails below"
    },
    {
      "fieldname": "notify_emails",
      "label": "Notify emails",
      "fieldtype": "LongText",
      "description": "One address per line or comma-separated — staff to alert on every submission"
    },
    {
      "fieldname": "sec_antispam",
      "label": "Anti-spam",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "captcha_enabled",
      "label": "Require CAPTCHA",
      "fieldtype": "Check",
      "default": false,
      "description": "Requires a captcha_provider to be configured for the site — otherwise ignored"
    },
    {
      "fieldname": "is_standard",
      "label": "Standard",
      "fieldtype": "Check",
      "in_list_view": true,
      "in_filter": true,
      "description": "Ships with the app as JSON files - edits are saved to the app"
    },
    {
      "fieldname": "app",
      "label": "App",
      "fieldtype": "Link",
      "options": "GruntInstalledApp",
      "depends_on": "is_standard",
      "mandatory_depends_on": "is_standard"
    },
    {
      "fieldname": "tab_designer",
      "label": "Builder",
      "fieldtype": "Tab",
      "tab_component": "WebFormDesignerTab",
      "icon": "LayoutTemplate"
    },
    {
      "fieldname": "fields",
      "label": "Fields",
      "fieldtype": "Table",
      "options": "WebFormField"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
