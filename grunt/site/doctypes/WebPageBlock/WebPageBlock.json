{
  "name": "WebPageBlock",
  "label": "Блок контенту сторінки",
  "module": "site",
  "is_child": true,
  "title_field": "title",
  "fields": [
    {
      "fieldname": "block_type",
      "label": "Тип блоку",
      "fieldtype": "Select",
      "options_source": "grunt.website.block_type",
      "required": true,
      "in_list_view": true,
      "default": "rich_text"
    },
    {
      "fieldname": "title",
      "label": "Заголовок",
      "fieldtype": "Text",
      "in_list_view": true
    },
    {
      "fieldname": "settings",
      "label": "Налаштування блоку",
      "fieldtype": "JSON",
      "hidden": true,
      "dynamic_schema_source": "grunt.website.block_type",
      "dynamic_schema_key": "block_type"
    },
    {
      "fieldname": "sequence",
      "label": "Порядок",
      "fieldtype": "Int",
      "default": 0
    }
  ]
}
