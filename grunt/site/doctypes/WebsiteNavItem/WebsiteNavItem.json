{
  "name": "WebsiteNavItem",
  "label": "Site menu item",
  "module": "site",
  "is_child": true,
  "title_field": "label",
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "url",
      "label": "URL",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "is_external",
      "label": "External link",
      "fieldtype": "Check",
      "default": false
    },
    {
      "fieldname": "group",
      "label": "Group (for the footer)",
      "fieldtype": "Text",
      "description": "Used only in the site footer to group links under a heading"
    },
    {
      "fieldname": "sequence",
      "label": "Order",
      "fieldtype": "Int",
      "default": 0
    }
  ]
}
