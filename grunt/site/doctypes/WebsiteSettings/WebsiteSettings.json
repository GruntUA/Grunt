{
  "name": "WebsiteSettings",
  "label": "Site settings",
  "module": "site",
  "is_singleton": true,
  "icon": "Globe",
  "fields": [
    {
      "fieldname": "sec_brand",
      "label": "Branding",
      "fieldtype": "Section"
    },
    {
      "fieldname": "col_b1",
      "fieldtype": "Column"
    },
    {
      "fieldname": "site_name",
      "label": "Site name",
      "fieldtype": "Text",
      "default": "Ґрунт",
      "columns": 12
    },
    {
      "fieldname": "brand_logo",
      "label": "Logo",
      "fieldtype": "Image",
      "columns": 12
    },
    {
      "fieldname": "col_b2",
      "fieldtype": "Column"
    },
    {
      "fieldname": "home_route",
      "label": "Home page route",
      "fieldtype": "Text",
      "description": "Route of the published WebPage used as the home page (a file-based www/index.html always takes priority)",
      "columns": 12
    },
    {
      "fieldname": "sec_footer",
      "label": "Site footer",
      "fieldtype": "Section"
    },
    {
      "fieldname": "copyright_text",
      "label": "Copyright text",
      "fieldtype": "Text",
      "default": "© 2026"
    },
    {
      "fieldname": "footer_columns",
      "label": "Footer columns",
      "fieldtype": "Table",
      "options": "WebsiteFooterColumn",
      "description": "Controls which footer columns show and in what order. Leave empty to auto-group footer links by their 'Group' field instead."
    },
    {
      "fieldname": "footer_items",
      "label": "Footer links",
      "fieldtype": "Table",
      "options": "WebsiteNavItem",
      "description": "The 'Group' field sets the column heading in the footer"
    },
    {
      "fieldname": "sec_seo",
      "label": "Default SEO",
      "fieldtype": "Section"
    },
    {
      "fieldname": "col_s1",
      "fieldtype": "Column"
    },
    {
      "fieldname": "default_meta_description",
      "label": "Default meta description",
      "fieldtype": "Text",
      "columns": 12
    },
    {
      "fieldname": "col_s2",
      "fieldtype": "Column"
    },
    {
      "fieldname": "default_og_image",
      "label": "Default social image",
      "fieldtype": "Image",
      "columns": 12
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
