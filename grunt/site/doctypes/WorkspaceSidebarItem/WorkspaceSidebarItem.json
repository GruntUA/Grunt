{
  "name": "WorkspaceSidebarItem",
  "label": "Пункт меню додатку",
  "module": "site",
  "is_child": true,
  "title_field": "label",
  "table_name": "grunt_workspace_sidebar_item",
  "fields": [
    {
      "fieldname": "type",
      "label": "Тип",
      "fieldtype": "Select",
      "options": "DocType\nReport\nPage\nURL\nDivider",
      "default": "DocType",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "section",
      "label": "Секція",
      "fieldtype": "Data",
      "in_list_view": true,
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "label",
      "label": "Назва",
      "fieldtype": "Data",
      "in_list_view": true,
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "icon",
      "label": "Іконка",
      "fieldtype": "Icon",
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "link_doctype",
      "label": "Doctype посилання",
      "fieldtype": "Data",
      "hidden": true
    },
    {
      "fieldname": "link_to",
      "label": "Посилання на",
      "fieldtype": "DynamicLink",
      "options": "link_doctype",
      "in_list_view": true,
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "is_singleton",
      "label": "Singleton (один запис)",
      "fieldtype": "Check",
      "default": false,
      "depends_on": "eval:doc.type == 'DocType'"
    },
    {
      "fieldname": "show_count",
      "label": "Показати лічильник",
      "fieldtype": "Check",
      "default": false,
      "depends_on": "eval:doc.type == 'DocType'"
    },
    {
      "fieldname": "count_filters",
      "label": "Фільтри лічильника (JSON)",
      "fieldtype": "Code",
      "options": "json",
      "default": "",
      "depends_on": "eval:doc.type == 'DocType' && doc.show_count"
    },
    {
      "fieldname": "roles",
      "label": "Ролі (через кому)",
      "fieldtype": "Text",
      "depends_on": "eval:doc.type != 'Divider'"
    }
  ]
}
