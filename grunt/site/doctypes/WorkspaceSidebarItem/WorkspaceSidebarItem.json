{
  "name": "WorkspaceSidebarItem",
  "label": "App menu item",
  "module": "site",
  "is_child": true,
  "title_field": "label",
  "table_name": "grunt_workspace_sidebar_item",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "type",
      "label": "Type",
      "fieldtype": "Select",
      "options": "DocType\nReport\nPage\nURL\nDivider",
      "translatable": true,
      "default": "DocType",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "section",
      "label": "Section",
      "fieldtype": "Data",
      "in_list_view": true,
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Data",
      "in_list_view": true,
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "icon",
      "label": "Icon",
      "fieldtype": "Icon",
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "link_doctype",
      "label": "Link DocType",
      "fieldtype": "Data",
      "hidden": true
    },
    {
      "fieldname": "link_to",
      "label": "Links to",
      "fieldtype": "DynamicLink",
      "options": "link_doctype",
      "in_list_view": true,
      "depends_on": "eval:doc.type != 'Divider'"
    },
    {
      "fieldname": "is_singleton",
      "label": "Singleton (one record)",
      "fieldtype": "Check",
      "default": false,
      "depends_on": "eval:doc.type == 'DocType'"
    },
    {
      "fieldname": "show_count",
      "label": "Show count",
      "fieldtype": "Check",
      "default": false,
      "depends_on": "eval:doc.type == 'DocType'"
    },
    {
      "fieldname": "count_filters",
      "label": "Count filters (JSON)",
      "fieldtype": "Code",
      "options": "json",
      "default": "",
      "depends_on": "eval:doc.type == 'DocType' && doc.show_count"
    },
    {
      "fieldname": "roles",
      "label": "Roles (comma-separated)",
      "fieldtype": "Text",
      "depends_on": "eval:doc.type != 'Divider'"
    }
  ]
}
