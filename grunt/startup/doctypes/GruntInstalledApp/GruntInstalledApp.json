{
  "name": "GruntInstalledApp",
  "label": "App Store",
  "module": "startup",
  "table_name": "grunt_meta_installed_app",
  "hide_from_activity_feed": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "version",
      "label": "Version",
      "fieldtype": "Text",
      "in_list_view": true,
      "default": "0.1.0"
    },
    {
      "fieldname": "installed_at",
      "label": "Installed",
      "fieldtype": "Datetime",
      "in_list_view": true
    },
    {
      "fieldname": "modules",
      "label": "Modules",
      "fieldtype": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
