{
  "name": "File",
  "label": "File",
  "module": "storage",
  "title_field": "file_name",
  "image_field": "thumbnail_url",
  "default_view": "gallery",
  "inherit_permission_from": [
    "attached_to_doctype",
    "attached_to_id"
  ],
  "fields": [
    {
      "fieldname": "file_name",
      "label": "File name",
      "fieldtype": "Text",
      "required": true,
      "in_list_view": true,
      "search": true
    },
    {
      "fieldname": "file_url",
      "label": "File URL",
      "fieldtype": "Text",
      "read_only": true
    },
    {
      "fieldname": "thumbnail_url",
      "label": "Thumbnail",
      "fieldtype": "Image",
      "read_only": true
    },
    {
      "fieldname": "file_size",
      "label": "Size (bytes)",
      "fieldtype": "Int",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "content_type",
      "label": "Content type",
      "fieldtype": "Text",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "content_hash",
      "label": "Content hash (SHA-256)",
      "fieldtype": "Data",
      "read_only": true,
      "in_filter": true,
      "index": true,
      "required": true
    },
    {
      "fieldname": "uploaded_by",
      "label": "Uploaded by",
      "fieldtype": "Link",
      "options": "User",
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "is_public",
      "label": "Public",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "sec_attachment",
      "label": "Binding",
      "fieldtype": "Section"
    },
    {
      "fieldname": "attached_to_doctype",
      "label": "Document DocType",
      "fieldtype": "Link",
      "options": "DocType",
      "in_filter": true
    },
    {
      "fieldname": "attached_to_id",
      "label": "Document ID",
      "fieldtype": "DynamicLink",
      "options": "attached_to_doctype"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "create": true
    },
    {
      "role": "All",
      "write": true,
      "delete": true,
      "match": "owner == user"
    }
  ]
}
