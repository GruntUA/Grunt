{
  "name": "FileFolder",
  "label": "Folder",
  "module": "storage",
  "icon": "Folder",
  "autoname": "hash",
  "title_field": "folder_name",
  "search_fields": [
    "folder_name"
  ],
  "is_tree": true,
  "tree_parent_field": "parent_folder",
  "tree_title_field": "folder_name",
  "tree_sort_by": "folder_name",
  "tree_sort_order": "asc",
  "shares_cover_subtree": true,
  "default_view": "tree",
  "description": "Folders of personal file spaces. Each user has a home folder; every other folder lives inside one and belongs to its owner's space. Sharing a folder shares everything below it. Moving a file between folders never touches the stored content.",
  "fields": [
    {
      "fieldname": "folder_name",
      "label": "Folder name",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "search": true
    },
    {
      "fieldname": "parent_folder",
      "label": "Parent folder",
      "fieldtype": "Link",
      "options": "FileFolder",
      "in_list_view": true,
      "in_filter": true,
      "index": true
    },
    {
      "fieldname": "space_user",
      "label": "Space owner",
      "fieldtype": "Link",
      "options": "User",
      "read_only": true,
      "in_list_view": true,
      "in_filter": true,
      "index": true,
      "description": "Whose personal space the folder belongs to - taken from the parent folder"
    },
    {
      "fieldname": "is_home",
      "label": "Home folder",
      "fieldtype": "Check",
      "read_only": true,
      "description": "The root folder of the owner's space"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "create": true
    },
    {
      "role": "All",
      "read": true,
      "write": true,
      "delete": true,
      "match": "space_user == user"
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
