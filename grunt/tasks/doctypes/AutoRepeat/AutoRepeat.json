{
  "name": "AutoRepeat",
  "label": "Auto Repeat",
  "module": "tasks",
  "icon": "repeat",
  "description": "Creates copies of a document on a schedule (monthly invoices, recurring orders, reminders)",
  "autoname": "AR-.#####",
  "title_field": "reference_document",
  "search_fields": [
    "reference_doctype",
    "reference_document"
  ],
  "indexes": [
    [
      "reference_doctype",
      "reference_document"
    ],
    [
      "status",
      "next_schedule_date"
    ]
  ],
  "status_field": "status",
  "track_changes": true,
  "status_indicators": [
    {
      "value": "Active",
      "color": "success",
      "label": "Active"
    },
    {
      "value": "Disabled",
      "color": "secondary",
      "label": "Disabled"
    },
    {
      "value": "Completed",
      "color": "primary",
      "label": "Completed"
    }
  ],
  "fields": [
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "required": true,
      "in_list_view": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "reference_document",
      "label": "Template document",
      "fieldtype": "DynamicLink",
      "options": "reference_doctype",
      "required": true,
      "in_list_view": true,
      "bold": true,
      "description": "Every repetition is a copy of this document"
    },
    {
      "fieldname": "col_status",
      "fieldtype": "Column"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Active\nDisabled\nCompleted",
      "default": "Active",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "disabled",
      "label": "Disabled",
      "fieldtype": "Check",
      "default": false
    },
    {
      "fieldname": "sec_schedule",
      "label": "Schedule",
      "fieldtype": "Section"
    },
    {
      "fieldname": "frequency",
      "label": "Frequency",
      "fieldtype": "Select",
      "options": "Daily\nWeekly\nMonthly\nQuarterly\nHalf-yearly\nYearly",
      "default": "Monthly",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "repeat_on_day",
      "label": "Day of month",
      "fieldtype": "Int",
      "min_value": 1,
      "max_value": 31,
      "depends_on": "eval: !['Daily', 'Weekly'].includes(doc.frequency) && !doc.repeat_on_last_day",
      "description": "Empty: the day of the start date. Short months use their last day"
    },
    {
      "fieldname": "repeat_on_last_day",
      "label": "Last day of month",
      "fieldtype": "Check",
      "default": false,
      "depends_on": "eval: !['Daily', 'Weekly'].includes(doc.frequency)"
    },
    {
      "fieldname": "col_dates",
      "fieldtype": "Column"
    },
    {
      "fieldname": "start_date",
      "label": "Start date",
      "fieldtype": "Date",
      "default": "Today",
      "required": true,
      "description": "The first copy is created on the first scheduled day on or after this date"
    },
    {
      "fieldname": "end_date",
      "label": "End date",
      "fieldtype": "Date",
      "description": "Empty: repeat until disabled"
    },
    {
      "fieldname": "next_schedule_date",
      "label": "Next run",
      "fieldtype": "Date",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "sec_copy",
      "label": "Copy",
      "fieldtype": "Section"
    },
    {
      "fieldname": "date_field",
      "label": "Date field",
      "fieldtype": "Data",
      "description": "Fieldname of a Date/Datetime field in the copy to set to the scheduled date (e.g. posting_date)"
    },
    {
      "fieldname": "notify",
      "label": "Notify me",
      "fieldtype": "Check",
      "default": true,
      "description": "Notify the owner of this rule when a copy is created or fails"
    },
    {
      "fieldname": "sec_log",
      "label": "History",
      "fieldtype": "Section",
      "collapsible": true
    },
    {
      "fieldname": "last_document",
      "label": "Last copy",
      "fieldtype": "DynamicLink",
      "options": "reference_doctype",
      "read_only": true
    },
    {
      "fieldname": "created_count",
      "label": "Copies created",
      "fieldtype": "Int",
      "default": 0,
      "read_only": true
    },
    {
      "fieldname": "col_log",
      "fieldtype": "Column"
    },
    {
      "fieldname": "last_run_at",
      "label": "Last run",
      "fieldtype": "Datetime",
      "read_only": true
    },
    {
      "fieldname": "last_error",
      "label": "Last error",
      "fieldtype": "LongText",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "write": true,
      "delete": true,
      "match": "owner == user"
    },
    {
      "role": "All",
      "create": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
