{
  "name": "ScheduledJob",
  "label": "Scheduled Jobs",
  "module": "tasks",
  "is_virtual": true,
  "fields": [
    {
      "fieldname": "job_id",
      "label": "Job ID",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "cron_expression",
      "label": "Cron expression",
      "fieldtype": "Data",
      "reqd": 1,
      "description": "For example: '*/5 * * * *' for every 5 minutes"
    },
    {
      "fieldname": "next_run_at",
      "label": "Next run",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "last_run_at",
      "label": "Last run",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending\nRunning\nSuccess\nFailed",
      "translatable": true,
      "read_only": 1,
      "default": "Pending"
    },
    {
      "fieldname": "last_error",
      "label": "Last error",
      "fieldtype": "Text",
      "read_only": 1
    },
    {
      "fieldname": "run_count",
      "label": "Run count",
      "fieldtype": "Int",
      "read_only": 1,
      "default": 0
    },
    {
      "fieldname": "executor",
      "label": "Assignee",
      "fieldtype": "Data",
      "reqd": 1,
      "description": "Function or module name to run"
    },
    {
      "fieldname": "params",
      "label": "Parameters",
      "fieldtype": "JSON",
      "description": "JSON parameters for the run"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
