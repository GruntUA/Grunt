{
  "name": "ScheduledJobLog",
  "label": "Лог завдань планувальника",
  "module": "tasks",
  "track_changes": false,
  "table_name": "grunt_scheduled_job_log",
  "track_activity": false,
  "track_deletions": false,
  "fields": [
    {
      "fieldname": "job_name",
      "label": "Назва завдання",
      "fieldtype": "Data",
      "required": true,
      "index": true,
      "in_list_view": true,
      "in_filter": true
    },
    {
      "fieldname": "started_at",
      "label": "Початок",
      "fieldtype": "Datetime",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "finished_at",
      "label": "Завершення",
      "fieldtype": "Datetime",
      "in_list_view": true
    },
    {
      "fieldname": "status",
      "label": "Статус",
      "fieldtype": "Select",
      "options": "Running\nSuccess\nFailed",
      "translatable": true,
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "index": true
    },
    {
      "fieldname": "error_message",
      "label": "Помилка",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "cron_expression",
      "label": "Cron вираз",
      "fieldtype": "Data"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true
    }
  ]
}
