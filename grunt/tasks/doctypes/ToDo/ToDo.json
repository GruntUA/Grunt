{
  "name": "ToDo",
  "label": "Job",
  "module": "tasks",
  "icon": "list-checks",
  "title_field": "description",
  "default_view": "list",
  "search_fields": [
    "description",
    "assigned_to",
    "reference_id"
  ],
  "indexes": [
    [
      "reference_doctype",
      "reference_id"
    ]
  ],
  "status_field": "status",
  "track_changes": true,
  "track_seen": true,
  "quick_entry": true,
  "kanban_column_field": "status",
  "calendar_date_field": "due_date",
  "calendar_title_field": "description",
  "gantt_start_field": "assigned_on",
  "gantt_end_field": "due_date",
  "gantt_title_field": "description",
  "gantt_color_field": "priority",
  "gantt_color_map": {
    "Urgent": "#ef4444",
    "High": "#f97316",
    "Medium": "#eab308",
    "Low": "#94a3b8"
  },
  "gantt_default_color": "#6366f1",
  "status_indicators": [
    {
      "value": "Open",
      "color": "warn",
      "label": "Open"
    },
    {
      "value": "In Progress",
      "color": "primary",
      "label": "In Progress"
    },
    {
      "value": "Closed",
      "color": "success",
      "label": "Done"
    },
    {
      "value": "Cancelled",
      "color": "secondary",
      "label": "Cancelled"
    }
  ],
  "actions": [
    {
      "action": "todo.complete",
      "variant": "success",
      "condition": "doc.status !== 'Closed' && doc.status !== 'Cancelled'"
    },
    {
      "action": "todo.reopen",
      "variant": "outline",
      "condition": "doc.status === 'Closed' || doc.status === 'Cancelled'"
    },
    {
      "action": "todo.cancel",
      "variant": "ghost",
      "condition": "doc.status === 'Open' || doc.status === 'In Progress'"
    }
  ],
  "fields": [
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "LongText",
      "required": true,
      "in_list_view": true,
      "bold": true
    },
    {
      "fieldname": "reference_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "in_list_view": true
    },
    {
      "fieldname": "reference_id",
      "label": "Document ID",
      "fieldtype": "DynamicLink",
      "options": "reference_doctype"
    },
    {
      "fieldname": "assigned_to",
      "label": "Assignee",
      "fieldtype": "Link",
      "options": "User",
      "in_list_view": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "assigned_by",
      "label": "Assigned by",
      "fieldtype": "Link",
      "options": "User",
      "read_only": true
    },
    {
      "fieldname": "assigned_on",
      "label": "Assigned to",
      "fieldtype": "Datetime",
      "read_only": true
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nIn Progress\nClosed\nCancelled",
      "translatable": true,
      "default": "Open",
      "in_list_view": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nUrgent",
      "translatable": true,
      "default": "Medium",
      "in_list_view": true,
      "in_quick_filter": true
    },
    {
      "fieldname": "due_date",
      "label": "Due date",
      "fieldtype": "Date",
      "in_list_view": true
    },
    {
      "fieldname": "is_overdue",
      "label": "Overdue",
      "fieldtype": "Check",
      "is_virtual": true,
      "read_only": true,
      "in_list_view": true,
      "read_formula": "bool(due_date) and status not in ('Closed', 'Cancelled') and str(due_date)[:10] < str(today)"
    },
    {
      "fieldname": "color",
      "label": "Color",
      "fieldtype": "Color"
    },
    {
      "fieldname": "sec_completion",
      "label": "Execution",
      "fieldtype": "Section"
    },
    {
      "fieldname": "completed_on",
      "label": "Done",
      "fieldtype": "Datetime",
      "read_only": true
    },
    {
      "fieldname": "completed_by",
      "label": "Run by",
      "fieldtype": "Link",
      "options": "User",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": true,
      "write": true,
      "match": "assigned_to == user"
    },
    {
      "role": "All",
      "read": true,
      "write": true,
      "delete": true,
      "match": "owner == user"
    },
    {
      "role": "All",
      "create": true
    },
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
