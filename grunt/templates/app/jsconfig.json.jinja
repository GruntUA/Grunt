{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["../grunt/frontend/src/*"]
    }
  },
  "include": [
    "{{ module }}/**/*.js",
    "{{ module }}/**/*.d.ts",
    "../grunt/frontend/src/vite-env.d.ts"
  ],
  "exclude": [
    "**/__pycache__/**",
    "**/node_modules/**"
  ]
}
