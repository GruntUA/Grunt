"""Custom FastAPI routes for {{ title }}.

The app loader includes this router under /api/v1/app/{{ app_name }}, so with
the prefix below a route lives at /api/v1/app/{{ app_name }}/{{ app_name }}/...
Use it for endpoints that are not covered by the generic /docs/* CRUD API.
"""

from __future__ import annotations

from grunt.api.router import GruntRouter

# GruntRouter puts the grunt context (DB session, user) around every endpoint;
# optional_auth=True lets guests in too (handlers see user=None).
router = GruntRouter(prefix="/{{ app_name }}", tags=["{{ title }}"])


