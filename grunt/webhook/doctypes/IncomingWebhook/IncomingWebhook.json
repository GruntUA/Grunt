{
  "name": "IncomingWebhook",
  "label": "Incoming Webhook",
  "module": "webhook",
  "table_name": "grunt_incoming_webhook",
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "slug",
      "label": "URL path (slug)",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true,
      "description": "Unique identifier in the URL: POST /api/v1/webhooks/incoming/{slug}"
    },
    {
      "fieldname": "secret",
      "label": "Secret (HMAC)",
      "fieldtype": "Text",
      "description": "If set, requests without a valid signature are rejected"
    },
    {
      "fieldname": "signature_header",
      "label": "Signature header",
      "fieldtype": "Data",
      "default": "X-Grunt-Signature",
      "description": "HTTP header expected to carry the signature (e.g. X-Hub-Signature-256)"
    },
    {
      "fieldname": "signature_type",
      "label": "Signature algorithm",
      "fieldtype": "Select",
      "options": "hmac_sha256\nhmac_sha1\nnone",
      "default": "hmac_sha256"
    },
    {
      "fieldname": "action",
      "label": "Action",
      "fieldtype": "Select",
      "options": "log_only\nrun_server_script\ncreate_document",
      "default": "log_only",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "server_script",
      "label": "Server Script",
      "fieldtype": "Link",
      "options": "ServerScript",
      "description": "Runs when action = run_server_script. The payload is available as the variable payload."
    },
    {
      "fieldname": "target_doctype",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "description": "Document type to create when action = create_document"
    },
    {
      "fieldname": "field_mapping",
      "label": "Field mapping (JSON)",
      "fieldtype": "LongText",
      "description": "JSON: {\"doctype_field\": \"payload.path.to.value\"}"
    },
    {
      "fieldname": "is_enabled",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true
    }
  ]
}
