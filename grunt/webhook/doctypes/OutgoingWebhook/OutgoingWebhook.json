{
  "name": "OutgoingWebhook",
  "label": "Outgoing Webhook",
  "module": "webhook",
  "table_name": "grunt_outgoing_webhook",
  "fields": [
    {
      "fieldname": "doctype_name",
      "label": "Document type",
      "fieldtype": "Link",
      "options": "DocType",
      "in_list_view": true,
      "in_filter": true,
      "mandatory_depends_on": "eval: doc.event != 'notification'"
    },
    {
      "fieldname": "event",
      "label": "Event",
      "fieldtype": "Select",
      "options": "after_insert\nafter_update\nafter_delete\non_submit\non_cancel\nnotification",
      "required": true,
      "in_list_view": true,
      "in_filter": true,
      "description": "notification - only from notification rules (their Webhook channel)"
    },
    {
      "fieldname": "url",
      "label": "Webhook URL",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "secret",
      "label": "Secret (HMAC)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "headers",
      "label": "Headers (JSON)",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "condition",
      "label": "Condition (Python)",
      "fieldtype": "LongText"
    },
    {
      "fieldname": "timeout",
      "label": "Timeout (sec)",
      "fieldtype": "Int",
      "default": 10
    },
    {
      "fieldname": "is_enabled",
      "label": "Active",
      "fieldtype": "Check",
      "default": true,
      "in_list_view": true,
      "in_filter": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "actions": ["read", "write", "create", "delete", "export", "import", "print", "share", "report"]
    }
  ]
}
